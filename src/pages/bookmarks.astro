---
import Layout from '../layouts/Layout.astro';
---

<Layout title="즐겨찾기" description="내가 저장한 사이트 목록" canonicalPath="/bookmarks" noindex>
  <h1 class="text-2xl font-bold text-slate-900">즐겨찾기</h1>
  <p class="mt-2 text-slate-500">이 브라우저에 저장된 즐겨찾기 사이트입니다.</p>

  <div id="bookmarks-empty" class="mt-10 hidden text-slate-400">
    아직 저장한 사이트가 없습니다. 사이트 카드의 ☆ 버튼을 눌러 저장해보세요.
  </div>

  <div id="bookmarks-grid" class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>

  <script>
    const BOOKMARK_KEY = 'siteda_bookmarks';

    function getBookmarks(): number[] {
      try {
        const raw = localStorage.getItem(BOOKMARK_KEY);
        return raw ? (JSON.parse(raw) as number[]) : [];
      } catch {
        return [];
      }
    }

    function escapeHtml(s: string): string {
      const div = document.createElement('div');
      div.textContent = s;
      return div.innerHTML;
    }

    async function render() {
      const ids = getBookmarks();
      const grid = document.getElementById('bookmarks-grid');
      const empty = document.getElementById('bookmarks-empty');
      if (!grid || !empty) return;

      if (ids.length === 0) {
        empty.classList.remove('hidden');
        return;
      }

      try {
        const res = await fetch(`/api/sites-by-ids?ids=${ids.join(',')}`);
        const data = (await res.json()) as {
          sites: { id: number; name: string; slug: string; tagline: string; logo_url: string | null; url: string; category_name: string }[];
        };

        if (data.sites.length === 0) {
          empty.classList.remove('hidden');
          return;
        }

        grid.innerHTML = data.sites
          .map(
            (site) => `
          <a href="/site/${encodeURIComponent(site.slug)}" class="block rounded-lg border border-slate-200 bg-white p-5 hover:border-slate-400 hover:shadow-sm transition">
            <div class="flex items-start gap-3">
              ${site.logo_url ? `<img src="${escapeHtml(site.logo_url)}" alt="" class="w-10 h-10 rounded-md object-cover object-left bg-white border border-slate-100 shrink-0" loading="lazy" />` : ''}
              <div class="min-w-0 flex-1">
                <div class="flex items-start justify-between gap-2">
                  <h3 class="font-semibold text-slate-900 truncate">${escapeHtml(site.name)}</h3>
                  <span class="shrink-0 rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500">${escapeHtml(site.category_name)}</span>
                </div>
                <p class="mt-1 text-sm text-slate-500 line-clamp-2">${escapeHtml(site.tagline)}</p>
              </div>
            </div>
          </a>`
          )
          .join('');
      } catch {
        empty.textContent = '즐겨찾기를 불러오지 못했습니다.';
        empty.classList.remove('hidden');
      }
    }

    render();
  </script>
</Layout>
