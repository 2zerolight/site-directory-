---
import Layout from '../layouts/Layout.astro';
import { SITE_NAME, CONTACT_EMAIL } from '../lib/site';

interface Faq {
  q: string;
  a: string;
}

interface FaqSection {
  /** 앵커용. id 에는 공백이 들어갈 수 없어 제목을 그대로 쓰면 링크가 깨진다. */
  id: string;
  title: string;
  items: Faq[];
}

const sections: FaqSection[] = [
  {
    id: 'about',
    title: '서비스 소개',
    items: [
      {
        q: `${SITE_NAME}는 어떤 서비스인가요?`,
        a: '분야별로 국내 웹사이트를 검색하고 발견할 수 있는 디렉토리 플랫폼입니다. 포털/검색, IT/개발, 쇼핑/가격비교, 정부/공공서비스 등 20여 개 카테고리로 실제 운영 중인 사이트를 정리해서 보여드립니다. 검색엔진처럼 모든 페이지를 긁어오는 것이 아니라, 사이트 단위로 사람이 검토해 올리는 목록입니다.',
      },
      {
        q: '검색엔진과 뭐가 다른가요?',
        a: '검색엔진은 "무엇을 찾는지" 알 때 유용하고, 디렉토리는 "이 분야에 어떤 곳들이 있는지" 훑어볼 때 유용합니다. 예를 들어 부동산 사이트를 처음 알아본다면 검색어를 떠올리기 전에 이 분야에 뭐가 있는지부터 보는 편이 빠릅니다.',
      },
    ],
  },
  {
    id: 'register',
    title: '사이트 등록',
    items: [
      {
        q: '사이트 등록은 어떻게 하나요?',
        a: '상단의 "사이트 등록" 버튼을 눌러 URL과 기본 정보를 입력하면 됩니다. URL만 입력하고 "자동 채우기"를 누르면 사이트의 이름·소개·로고를 자동으로 불러올 수 있어, 대부분 몇 분이면 끝납니다.',
      },
      {
        q: '등록 비용이 있나요?',
        a: '없습니다. 등록, 소유권 인증, 인증 배지 사용까지 모두 무료이며, 상호 링크를 걸어야 한다는 조건도 없습니다. 유료 우선 노출 같은 상품도 운영하지 않습니다.',
      },
      {
        q: '등록한 사이트가 바로 노출되나요?',
        a: '아니요. 등록 후 관리자 검토를 거쳐 승인된 사이트만 디렉토리에 노출됩니다. 스팸이나 잘못된 정보를 걸러내기 위한 절차입니다.',
      },
      {
        q: '제가 운영하는 사이트가 아니어도 등록할 수 있나요?',
        a: '네, 가능합니다. 소유자가 아니어도 등록할 수 있으며, 등록 폼 마지막의 "제가 운영하는 사이트가 아닙니다"에 체크해주시면 됩니다. 이런 제출은 관리자가 조금 더 꼼꼼히 검토하고, 소유권 인증 배지는 발급되지 않습니다.',
      },
      {
        q: '이미 등록된 사이트인지 어떻게 확인하나요?',
        a: '등록 폼에 URL을 입력하면 같은 도메인이 이미 등록돼 있는지 자동으로 확인해 알려드립니다. www 유무는 같은 사이트로 처리합니다. 중복으로 등록해도 관리자 검토 단계에서 걸러집니다.',
      },
      {
        q: '등록하면 어떤 정보가 공개되나요?',
        a: '사이트명, 주소, 소개, 분류, 지역, 운영 주체, 사업자명, 고객센터, 공개 이메일, SNS 주소 등 입력하신 항목이 상세 페이지에 그대로 표시됩니다. 다만 제출할 때 입력하는 "제출자 이메일"은 연락용이라 공개되지 않습니다. 공개를 원하지 않는 항목은 비워두시면 됩니다.',
      },
      {
        q: '등록된 정보가 잘못됐거나 사이트 주소가 바뀌었어요.',
        a: '현재 별도의 수정 요청 폼이 없어, 바뀐 정보로 다시 등록해주시면 관리자가 확인 후 기존 등록을 갱신합니다. 소유권 인증을 마치신 경우 인증 정보는 유지됩니다.',
      },
      {
        q: '등록을 내리고 싶어요.',
        a: '아직 셀프 삭제 기능이 없습니다. 특히 본인이 운영하지 않는 사이트가 제3자에 의해 등록된 경우 빠르게 내려드려야 하는데, 현재는 별도 요청 창구를 준비 중입니다. 급한 경우 사이트에 게시된 연락처로 알려주시면 확인 후 처리합니다.',
      },
    ],
  },
  {
    id: 'verify',
    title: '소유권 인증',
    items: [
      {
        q: '소유권 인증은 무엇인가요?',
        a: '등록된 사이트의 도메인을 실제로 통제하는 사람이 맞는지 확인하는 절차입니다. 확인하는 것은 도메인 소유 여부뿐이며, 사업체의 적법성이나 서비스 품질을 심사하는 것은 아닙니다.',
      },
      {
        q: '어떻게 인증하나요?',
        a: `사이트를 등록하시면 곧바로 그 사이트 전용 인증 페이지로 이동합니다. 거기에 적힌 인증값을 홈페이지 <head>에 메타태그로 넣거나 도메인 DNS에 TXT 레코드로 추가한 뒤 "지금 확인" 버튼을 누르시면 바로 인증됩니다. 인증 페이지 주소는 그 사이트의 열쇠라서 제출하신 분만 알 수 있으니 저장해두세요. 나중에 다시 방문해 이어서 진행할 수 있습니다. 이미 등록된 사이트의 운영자시라면 ${CONTACT_EMAIL} 로 알려주시면 인증 링크를 보내드립니다.`
      },
      {
        q: '메타태그와 DNS TXT 중 어느 쪽이 나은가요?',
        a: '홈페이지 HTML을 직접 수정할 수 있다면 메타태그가 가장 빠릅니다. 반영이 즉시 되기 때문입니다. 워드프레스나 임대형 솔루션처럼 head 수정이 번거로운 경우, 또는 홈페이지를 자주 갈아엎는 경우에는 DNS TXT가 안정적입니다.',
      },
      {
        q: '설정했는데 인증 확인이 안 됩니다.',
        a: 'DNS TXT는 전파에 보통 몇 분에서 길게는 몇 시간이 걸립니다. 메타태그는 반영이 빠르지만, 캐시 플러그인이나 CDN을 쓰신다면 캐시를 비워야 반영됩니다. 또 메타태그는 반드시 <head> 안에 있어야 하며 <body>에 넣으면 인식되지 않습니다.',
      },
      {
        q: 'www가 붙은 주소와 붙지 않은 주소가 다른가요?',
        a: '인증은 등록하신 주소를 기준으로 확인합니다. 메타태그 방식은 등록된 주소로 접속했을 때 태그가 보이면 되고, DNS TXT 방식은 등록된 주소의 도메인에 레코드가 있으면 됩니다. 두 주소가 서로 리디렉션되도록 설정돼 있다면 대부분 문제없이 통과합니다.',
      },
      {
        q: '인증하면 무엇이 달라지나요?',
        a: '상세 페이지에 "소유권 인증됨" 표시가 붙고, 목록에서 사이트명 옆에 인증 마크가 표시됩니다. 그리고 내 사이트에 붙일 수 있는 인증 배지가 발급됩니다.',
      },
    ],
  },
  {
    id: 'badge',
    title: '인증 배지',
    items: [
      {
        q: '인증 배지가 무엇인가요?',
        a: `소유권 인증을 마친 사이트가 자기 홈페이지에 붙일 수 있는 표식입니다. 월계관 안에 인증 체크가 들어가고 ${SITE_NAME}의 주소가 함께 표시됩니다. 방문자가 배지를 누르면 ${SITE_NAME}의 해당 사이트 등록 정보 페이지로 이동해, 어떤 근거로 붙은 표식인지 직접 확인할 수 있습니다.`,
      },
      {
        q: '배지는 어떻게 받나요?',
        a: '소유권 인증을 마치면 인증 페이지에 "인증 배지 받기" 버튼이 나타나고, 거기서 붙여넣을 코드를 바로 가져가실 수 있습니다. 기본·컴팩트·씰 세 가지 스타일과 라이트·다크 두 가지 테마가 있고, 이미지 태그 방식과 인라인 SVG 방식 둘 다 제공합니다.',
      },
      {
        q: '배지 사용에 조건이나 비용이 있나요?',
        a: '없습니다. 무료이고, 상호 링크를 거는 조건도 아닙니다. 배지를 내리셔도 등록과 인증 상태는 그대로 유지됩니다.',
      },
      {
        q: '배지 이미지가 보이지 않습니다.',
        a: '가장 흔한 원인은 소유권 인증이 아직 완료되지 않은 경우입니다. 인증되지 않은 사이트에는 배지를 제공하지 않기 때문에 이미지가 뜨지 않습니다. 인증을 마치셨는데도 그대로라면 브라우저 캐시 때문일 수 있으니 강력 새로고침을 한 번 해보세요. 배지 이미지는 최대 1시간 캐시됩니다.',
      },
      {
        q: '배지를 붙이면 검색 순위가 올라가나요?',
        a: `순위 상승을 보장하지는 않습니다. 다만 배지 링크는 ${SITE_NAME}의 해당 사이트 등록 정보 페이지로 연결되므로, 그 페이지가 검색엔진에 발견될 경로가 생깁니다. 배지는 순위 조작 수단이 아니라 방문자에게 보여주는 신뢰 표식으로 봐주세요.`,
      },
      {
        q: '배지 코드를 고쳐서 써도 되나요?',
        a: '크기 조절이나 배치 변경은 자유롭게 하셔도 됩니다. 다만 링크 대상과 alt 텍스트는 그대로 두시길 권합니다. 링크를 다른 곳으로 돌리면 방문자가 인증 근거를 확인할 수 없고, alt 텍스트를 원하는 키워드로 바꾸면 검색엔진이 링크 스팸으로 볼 수 있습니다.',
      },
      {
        q: '인증이 취소되면 배지는 어떻게 되나요?',
        a: '메타태그를 지우거나 DNS 레코드를 삭제하는 등으로 인증 상태가 해제되면 배지 이미지가 더 이상 제공되지 않습니다. 사실이 아닌 인증 표시가 남지 않도록 하기 위해서입니다.',
      },
    ],
  },
  {
    id: 'usage',
    title: '이용',
    items: [
      {
        q: '리뷰는 어떻게 작성하나요?',
        a: '각 사이트 상세 페이지 하단의 "리뷰 남기기"를 눌러 별점과 후기를 남길 수 있습니다. 로그인 없이 작성할 수 있으며, 작성된 리뷰는 검토를 거쳐 게시됩니다.',
      },
      {
        q: '즐겨찾기는 어디에 저장되나요?',
        a: '회원 계정이 없기 때문에 즐겨찾기는 지금 쓰시는 브라우저 안에만 저장됩니다. 다른 기기나 다른 브라우저에서는 보이지 않고, 브라우저 데이터를 지우면 함께 사라집니다.',
      },
      {
        q: '"정상 접속 확인됨"은 무슨 뜻인가요?',
        a: '등록 또는 검토 시점에 해당 주소로 접속이 되는지 확인한 결과입니다. 실시간 감시가 아니므로, 확인 이후에 사이트가 중단됐다면 표시가 실제와 다를 수 있습니다. 상세 페이지의 "최종 확인일"을 함께 참고해주세요.',
      },
      {
        q: '"인기 사이트"는 어떤 기준인가요?',
        a: `${SITE_NAME} 안에서의 조회수를 기준으로 정렬합니다. 해당 사이트의 실제 방문자 수나 인지도와는 다르며, 광고비를 받고 순서를 올리지는 않습니다.`,
      },
      {
        q: '카테고리가 잘못 분류된 것 같아요.',
        a: '여러 분야에 걸친 사이트는 분류가 애매할 수 있습니다. 대분류와 중분류, 태그를 함께 활용해 찾아보시면 도움이 되고, 명백히 잘못된 분류는 검토 과정에서 계속 바로잡고 있습니다.',
      },
    ],
  },
  {
    id: 'policy',
    title: '정책',
    items: [
      {
        q: '어떤 사이트가 거절되나요?',
        a: '접속이 되지 않거나, 실제 내용이 없는 빈 페이지이거나, 불법 정보를 다루는 사이트는 승인하지 않습니다. 같은 운영자가 사실상 같은 내용의 사이트를 여러 개 올리는 경우도 대표 사이트 하나만 남깁니다.',
      },
      {
        q: '사이트로 나가는 링크에 nofollow가 붙나요?',
        a: '네, 붙습니다. 디렉토리 특성상 등록된 사이트 수가 많아, 검색엔진이 링크 매매로 오해하지 않도록 외부로 나가는 링크에는 nofollow와 sponsored 속성을 함께 사용합니다. 등록만으로 검색 순위가 오르지는 않는다는 뜻이기도 합니다.',
      },
      {
        q: '리뷰나 등록 정보에 문제가 있으면 어떻게 하나요?',
        a: '허위 사실이나 비방이 담긴 리뷰, 사실과 다른 등록 정보는 확인 후 삭제하거나 수정합니다. 리뷰는 게시 전 검토를 거치지만 모든 내용을 사전에 걸러낼 수는 없어, 발견하시면 알려주시면 빠르게 조치하겠습니다.',
      },
    ],
  },
];

const allFaqs = sections.flatMap((section) => section.items);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout
  title="자주 묻는 질문"
  description={`${SITE_NAME} 등록, 소유권 인증, 인증 배지, 이용 정책에 관해 자주 묻는 질문 ${allFaqs.length}가지를 모았습니다.`}
  canonicalPath="/faq"
  jsonLd={jsonLd}
>
  <nav class="text-sm text-slate-400 mb-4">
    <a href="/" class="hover:text-slate-600">홈</a> <span class="mx-1">/</span> 자주 묻는 질문
  </nav>

  <h1 class="text-2xl font-bold text-slate-900">자주 묻는 질문</h1>
  <p class="mt-2 text-slate-500">
    등록부터 소유권 인증, 인증 배지, 이용 정책까지 {allFaqs.length}가지를 정리했습니다.
  </p>

  <nav class="mt-5 flex flex-wrap gap-2">
    {sections.map((section) => (
      <a
        href={`#${section.id}`}
        class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm text-slate-600 hover:border-slate-400 hover:text-slate-900"
      >
        {section.title}
      </a>
    ))}
  </nav>

  {sections.map((section) => (
    <section class="mt-10 scroll-mt-6" id={section.id}>
      <h2 class="text-lg font-semibold text-slate-900">{section.title}</h2>
      <div class="mt-3 divide-y divide-slate-100 rounded-lg border border-slate-200 bg-white">
        {section.items.map((item) => (
          <details class="group p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-medium text-slate-900">
              {item.q}
              <span class="shrink-0 text-slate-400 transition group-open:rotate-180">⌄</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{item.a}</p>
          </details>
        ))}
      </div>
    </section>
  ))}

  <p class="mt-10 text-sm text-slate-400">
    찾으시는 답이 없다면 <a href="/submit" class="underline hover:text-slate-600">사이트 등록</a> 페이지의 안내도 함께 확인해보세요.
  </p>
</Layout>
