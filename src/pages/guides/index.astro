---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE_URL } from '../../lib/site';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const formatDate = (d: Date) =>
  d.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });

const description = '분야별로 어떤 사이트가 있고 무엇이 다른지 정리한 글 모음입니다.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '가이드',
  description,
  url: new URL('/guides', SITE_URL).toString(),
  hasPart: guides.map((g) => ({
    '@type': 'Article',
    headline: g.data.title,
    url: new URL(`/guides/${g.id}`, SITE_URL).toString(),
    datePublished: g.data.publishDate.toISOString(),
  })),
};
---

<Layout title="가이드" description={description} canonicalPath="/guides" jsonLd={jsonLd}>
  <nav class="text-sm text-slate-400 mb-4">
    <a href="/" class="hover:text-slate-600">홈</a> <span class="mx-1">/</span> 가이드
  </nav>

  <h1 class="text-2xl font-bold text-slate-900">가이드</h1>
  <p class="mt-2 text-slate-500">
    "이런 건 어느 사이트에서 하지"에 답하는 글입니다. 디렉토리에 등록된 정보를 바탕으로,
    같은 분야 사이트들이 각각 무엇을 하는 곳인지 비교해 정리합니다.
  </p>

  {guides.length === 0 ? (
    <p class="mt-8 text-slate-400">아직 등록된 글이 없습니다.</p>
  ) : (
    <ul class="mt-6 space-y-4">
      {guides.map((guide) => (
        <li class="rounded-lg border border-slate-200 bg-white p-5 hover:border-slate-400 transition">
          <a href={`/guides/${guide.id}`} class="block">
            <h2 class="text-lg font-semibold text-slate-900">{guide.data.title}</h2>
            <p class="mt-1.5 text-sm text-slate-600">{guide.data.lead}</p>
            <p class="mt-2 text-xs text-slate-400">{formatDate(guide.data.publishDate)}</p>
          </a>
        </li>
      ))}
    </ul>
  )}
</Layout>
