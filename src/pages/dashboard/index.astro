---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import AdminSiteCard from '../../components/AdminSiteCard.astro';
import {
  setSiteStatus,
  checkSiteHealth,
  updateSiteFields,
  adminVerifyOwnership,
  getCategories,
  getAllSubcategories,
  getSitesForAdmin,
  getSiteById,
  setSiteTags,
  bulkMoveCategory,
  type AdminSiteStatusFilter,
} from '../../lib/db';
import { normalizeRequiredUrl, normalizeOptionalUrl } from '../../lib/urls';
import { ADMIN_COOKIE_NAME, createSessionCookieValue, isValidSessionCookieValue } from '../../lib/auth';

const adminPassword = env.ADMIN_PASSWORD;

let loginError = '';

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const action = String(data.get('action') ?? '');

  if (action === 'login') {
    const password = String(data.get('password') ?? '');
    if (password && password === adminPassword) {
      const cookieValue = await createSessionCookieValue(adminPassword);
      Astro.cookies.set(ADMIN_COOKIE_NAME, cookieValue, {
        httpOnly: true,
        secure: true,
        sameSite: 'lax',
        path: '/',
        maxAge: 60 * 60 * 24 * 7,
      });
      return Astro.redirect('/dashboard');
    }
    loginError = '비밀번호가 올바르지 않습니다.';
  } else if (action === 'logout') {
    Astro.cookies.delete(ADMIN_COOKIE_NAME, { path: '/' });
    return Astro.redirect('/dashboard');
  } else {
    const isAuthed = await isValidSessionCookieValue(adminPassword, Astro.cookies.get(ADMIN_COOKIE_NAME)?.value);

    if (isAuthed) {
      const id = Number(data.get('id'));
      const redirectTo = String(data.get('redirectTo') ?? '');
      const backTo = `/dashboard${redirectTo}`;

      if (id && (action === 'approve' || action === 'reject' || action === 'set_pending')) {
        const url = String(data.get('url') ?? '');
        if (action === 'approve' && url) {
          await checkSiteHealth(env.DB, id, url);
        }
        const status = action === 'approve' ? 'approved' : action === 'reject' ? 'rejected' : 'pending';
        await setSiteStatus(env.DB, id, status);
        return Astro.redirect(`${backTo}#site-${id}`);
      }

      if (action === 'bulk_approve' || action === 'bulk_reject') {
        const ids = data
          .getAll('ids')
          .map((v) => Number(v))
          .filter((n) => Number.isInteger(n) && n > 0);
        const status = action === 'bulk_approve' ? 'approved' : 'rejected';

        await Promise.all(
          ids.map(async (siteId) => {
            if (status === 'approved') {
              const site = await getSiteById(env.DB, siteId);
              if (site) await checkSiteHealth(env.DB, siteId, site.url);
            }
            await setSiteStatus(env.DB, siteId, status);
          })
        );
        return Astro.redirect(backTo);
      }

      if (action === 'bulk_move_category') {
        const ids = data
          .getAll('ids')
          .map((v) => Number(v))
          .filter((n) => Number.isInteger(n) && n > 0);
        const categoryId = Number(data.get('categoryId'));
        if (ids.length > 0 && categoryId) {
          await bulkMoveCategory(env.DB, ids, categoryId);
        }
        return Astro.redirect(backTo);
      }

      if (id && action === 'verify_admin') {
        await adminVerifyOwnership(env.DB, id);
        return Astro.redirect(`${backTo}#site-${id}`);
      }

      if (id && action === 'update') {
        const get = (key: string) => String(data.get(key) ?? '').trim();

        const name = get('name');
        const tagline = get('tagline');
        const description = get('description');
        const categoryId = Number(get('categoryId') || '');
        const subcategoryId = get('subcategoryId') ? Number(get('subcategoryId')) : null;

        const normalizedUrl = normalizeRequiredUrl(get('url'));
        const logo = normalizeOptionalUrl(get('logoUrl'));
        const cover = normalizeOptionalUrl(get('coverImageUrl'));
        const blog = normalizeOptionalUrl(get('blogUrl'));
        const youtube = normalizeOptionalUrl(get('youtubeUrl'));
        const instagram = normalizeOptionalUrl(get('instagramUrl'));
        const facebook = normalizeOptionalUrl(get('facebookUrl'));
        const otherSns = normalizeOptionalUrl(get('otherSnsUrl'));

        const valid =
          name &&
          normalizedUrl &&
          tagline &&
          description &&
          categoryId &&
          logo.ok &&
          cover.ok &&
          blog.ok &&
          youtube.ok &&
          instagram.ok &&
          facebook.ok &&
          otherSns.ok;

        if (valid) {
          await updateSiteFields(env.DB, id, {
            name,
            url: normalizedUrl!.toString(),
            tagline,
            description,
            logoUrl: logo.value,
            coverImageUrl: cover.value,
            categoryId,
            subcategoryId,
            region: get('region') || null,
            siteType: get('siteType') || null,
            platform: get('platform') || null,
            mainKeywords: get('mainKeywords') || null,
            serviceKeywords: get('serviceKeywords') || null,
            operatorName: get('operatorName') || null,
            businessName: get('businessName') || null,
            serviceRegion: get('serviceRegion') || null,
            customerCenter: get('customerCenter') || null,
            contactEmail: get('contactEmail') || null,
            blogUrl: blog.value,
            youtubeUrl: youtube.value,
            instagramUrl: instagram.value,
            facebookUrl: facebook.value,
            otherSnsUrl: otherSns.value,
          });
          const tagNames = get('tags').split(',').map((t) => t.trim()).filter(Boolean);
          await setSiteTags(env.DB, id, tagNames);
          return Astro.redirect(`${backTo}#site-${id}`);
        }

        const sep = redirectTo.includes('?') ? '&' : '?';
        return Astro.redirect(`${backTo}${sep}error=update#site-${id}`);
      }
    }

    return Astro.redirect('/dashboard');
  }
}

const isAuthed = await isValidSessionCookieValue(adminPassword, Astro.cookies.get(ADMIN_COOKIE_NAME)?.value);

const statusParam = (Astro.url.searchParams.get('status') ?? 'pending') as AdminSiteStatusFilter;
const status: AdminSiteStatusFilter = (['pending', 'approved', 'rejected', 'all'] as const).includes(statusParam)
  ? statusParam
  : 'pending';
const searchQuery = Astro.url.searchParams.get('q') ?? '';
const singleSiteId = Number(Astro.url.searchParams.get('site') || '');

const categories = isAuthed ? await getCategories(env.DB) : [];
const subcategories = isAuthed ? await getAllSubcategories(env.DB) : [];
const updateFailed = Astro.url.searchParams.get('error') === 'update';

const singleSite = isAuthed && singleSiteId ? await getSiteById(env.DB, singleSiteId) : null;
const listResult =
  isAuthed && !singleSiteId ? await getSitesForAdmin(env.DB, { status, query: searchQuery || undefined }) : null;

const currentQueryString = Astro.url.search;

const tabs: { value: AdminSiteStatusFilter; label: string }[] = [
  { value: 'pending', label: '대기' },
  { value: 'approved', label: '승인됨' },
  { value: 'rejected', label: '거절됨' },
  { value: 'all', label: '전체' },
];
---

<Layout title="관리자" description="사이트 등록 관리" canonicalPath="/dashboard" noindex>
  {!isAuthed ? (
    <div class="max-w-sm mx-auto mt-10">
      <h1 class="text-xl font-bold text-slate-900">관리자 로그인</h1>
      {loginError && <p class="mt-3 text-sm text-red-600">{loginError}</p>}
      <form method="post" class="mt-4 space-y-3">
        <input type="hidden" name="action" value="login" />
        <input
          type="password" name="password" required placeholder="비밀번호" autofocus
          class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
        />
        <button type="submit" class="w-full rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">
          로그인
        </button>
      </form>
    </div>
  ) : (
    <div>
      <script type="application/json" id="all-subcategories-data" is:inline set:html={JSON.stringify(subcategories)} />
      <div class="flex items-center justify-between">
        <h1 class="text-xl font-bold text-slate-900">사이트 관리</h1>
        <div class="flex items-center gap-4 text-sm">
          <a href="/dashboard/stats" class="text-slate-400 underline hover:text-slate-700">통계</a>
          <a href="/dashboard/reviews" class="text-slate-400 underline hover:text-slate-700">리뷰 관리</a>
          <form method="post">
            <input type="hidden" name="action" value="logout" />
            <button type="submit" class="text-slate-400 hover:text-slate-700 underline">로그아웃</button>
          </form>
        </div>
      </div>

      {updateFailed && (
        <div class="mt-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-700">
          수정 내용을 저장하지 못했습니다. 필수 항목(이름·URL·한 줄 소개·상세 설명·대분류)과 URL 형식을 확인해주세요.
        </div>
      )}

      {singleSite ? (
        <div class="mt-6">
          <a href="/dashboard" class="text-sm text-slate-400 underline hover:text-slate-700">← 전체 목록으로</a>
          <ul class="mt-3 space-y-3">
            <AdminSiteCard site={singleSite} categories={categories} subcategories={subcategories} redirectTo={`?site=${singleSite.id}`} />
          </ul>
        </div>
      ) : singleSiteId ? (
        <p class="mt-8 text-slate-400">
          해당 사이트를 찾을 수 없습니다. <a href="/dashboard" class="underline">← 전체 목록으로</a>
        </p>
      ) : (
        <>
          <div class="mt-4 flex flex-wrap items-center gap-2">
            {tabs.map((tab) => (
              <a
                href={`/dashboard?status=${tab.value}${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ''}`}
                class={`rounded-full px-3 py-1.5 text-sm font-medium ${
                  status === tab.value ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
                }`}
              >
                {tab.label}
              </a>
            ))}
            <form method="get" class="ml-auto flex gap-2">
              <input type="hidden" name="status" value={status} />
              <input
                type="search" name="q" value={searchQuery} placeholder="이름·URL 검색"
                class="rounded-md border border-slate-300 px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
              />
              <button type="submit" class="rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-600 hover:bg-slate-50">검색</button>
            </form>
          </div>

          {listResult && (
            <>
              <p class="mt-3 text-sm text-slate-400">
                총 {listResult.total}개
                {listResult.total > listResult.sites.length ? ` 중 최근 ${listResult.sites.length}개 표시 (검색으로 좁혀보세요)` : ''}
              </p>

              {listResult.sites.length === 0 ? (
                <p class="mt-8 text-slate-400">조건에 맞는 사이트가 없습니다.</p>
              ) : (
                <>
                  <form id="bulk-form" method="post">
                    <input type="hidden" name="redirectTo" value={currentQueryString} />
                  </form>

                  <div class="mt-4 flex flex-wrap items-center gap-3 text-sm">
                    <label class="flex items-center gap-1.5 text-slate-600">
                      <input type="checkbox" id="select-all" />
                      전체 선택
                    </label>
                    <span id="selected-count" class="text-slate-400"></span>
                    <div class="ml-auto flex flex-wrap items-center gap-2">
                      <select
                        name="categoryId" form="bulk-form"
                        class="rounded-md border border-slate-300 px-2 py-1.5 text-xs text-slate-600 focus:outline-none focus:ring-2 focus:ring-slate-900"
                      >
                        {categories.map((c) => <option value={c.id}>{c.name}</option>)}
                      </select>
                      <button type="submit" form="bulk-form" name="action" value="bulk_move_category" class="rounded-md border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50">
                        카테고리 이동
                      </button>
                      <button type="submit" form="bulk-form" name="action" value="bulk_approve" class="rounded-md bg-green-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-green-500">
                        선택 승인
                      </button>
                      <button type="submit" form="bulk-form" name="action" value="bulk_reject" class="rounded-md bg-red-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-red-500">
                        선택 거절
                      </button>
                    </div>
                  </div>

                  <ul class="mt-3 space-y-3">
                    {listResult.sites.map((site) => (
                      <AdminSiteCard site={site} categories={categories} subcategories={subcategories} redirectTo={currentQueryString} />
                    ))}
                  </ul>
                </>
              )}
            </>
          )}
        </>
      )}
    </div>
  )}

  <script>
    function withDefaultProtocol(raw: string): string {
      const trimmed = raw.trim();
      if (!trimmed || /^https?:\/\//i.test(trimmed)) return trimmed;
      return `https://${trimmed}`;
    }

    document.querySelectorAll('input[inputmode="url"]').forEach((el) => {
      el.addEventListener('blur', () => {
        const input = el as HTMLInputElement;
        input.value = withDefaultProtocol(input.value);
      });
    });

    const selectAll = document.getElementById('select-all') as HTMLInputElement | null;
    const selectedCount = document.getElementById('selected-count');
    const itemCheckboxes = () =>
      Array.from(document.querySelectorAll<HTMLInputElement>('input[name="ids"][form="bulk-form"]'));

    function updateSelectedCount() {
      const n = itemCheckboxes().filter((cb) => cb.checked).length;
      if (selectedCount) selectedCount.textContent = n > 0 ? `${n}개 선택됨` : '';
    }

    selectAll?.addEventListener('change', () => {
      itemCheckboxes().forEach((cb) => {
        cb.checked = selectAll.checked;
      });
      updateSelectedCount();
    });

    itemCheckboxes().forEach((cb) => cb.addEventListener('change', updateSelectedCount));

    type SubcategoryRow = { id: number; category_id: number; name: string };

    const subcategoryDataEl = document.getElementById('all-subcategories-data');
    const allSubcategories: SubcategoryRow[] = subcategoryDataEl ? JSON.parse(subcategoryDataEl.textContent || '[]') : [];

    document.addEventListener('change', (e) => {
      const target = e.target as HTMLElement;
      if (!(target instanceof HTMLSelectElement) || target.name !== 'categoryId') return;

      const form = target.closest('form');
      const subcategorySelect = form?.querySelector('select[name="subcategoryId"]') as HTMLSelectElement | null | undefined;
      if (!subcategorySelect) return;

      const matching = allSubcategories.filter((s) => String(s.category_id) === target.value);
      subcategorySelect.innerHTML = '';
      const noneOpt = document.createElement('option');
      noneOpt.value = '';
      noneOpt.textContent = '선택 안 함';
      subcategorySelect.appendChild(noneOpt);
      for (const sub of matching) {
        const opt = document.createElement('option');
        opt.value = String(sub.id);
        opt.textContent = sub.name;
        subcategorySelect.appendChild(opt);
      }
    });
  </script>
</Layout>
