---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import { getDashboardStats, getStaleApprovedSites, checkSiteHealth } from '../../lib/db';
import { ADMIN_COOKIE_NAME, isValidSessionCookieValue } from '../../lib/auth';

const adminPassword = env.ADMIN_PASSWORD;
const isAuthed = await isValidSessionCookieValue(adminPassword, Astro.cookies.get(ADMIN_COOKIE_NAME)?.value);

if (!isAuthed) {
  return Astro.redirect('/dashboard');
}

let recheckMessage = '';

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  if (String(data.get('action') ?? '') === 'recheck_stale') {
    const staleSites = await getStaleApprovedSites(env.DB, 20);
    await Promise.all(staleSites.map((site) => checkSiteHealth(env.DB, site.id, site.url)));
    recheckMessage = `${staleSites.length}개 사이트 상태를 재점검했습니다.`;
  }
}

const stats = await getDashboardStats(env.DB);
const formatDate = (value: string) =>
  new Date(value.replace(' ', 'T') + 'Z').toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title="통계" description="사이트다 운영 통계" canonicalPath="/dashboard/stats" noindex>
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-bold text-slate-900">운영 통계</h1>
    <div class="flex gap-4 text-sm">
      <a href="/dashboard" class="text-slate-400 underline hover:text-slate-700">사이트 관리</a>
      <a href="/dashboard/reviews" class="text-slate-400 underline hover:text-slate-700">
        리뷰 관리{stats.pendingReviewsCount > 0 ? ` (${stats.pendingReviewsCount})` : ''}
      </a>
      <a href="/api/export-sites.csv" class="text-slate-400 underline hover:text-slate-700">CSV 내보내기</a>
    </div>
  </div>

  {recheckMessage && (
    <div class="mt-4 rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-700">{recheckMessage}</div>
  )}

  <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-xs text-slate-400">승인됨</p>
      <p class="mt-1 text-2xl font-bold text-slate-900">{stats.totalApproved}</p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-xs text-slate-400">대기</p>
      <p class="mt-1 text-2xl font-bold text-slate-900">{stats.totalPending}</p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-xs text-slate-400">거절됨</p>
      <p class="mt-1 text-2xl font-bold text-slate-900">{stats.totalRejected}</p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-xs text-slate-400">30일 이상 미점검</p>
      <p class="mt-1 text-2xl font-bold text-slate-900">{stats.staleSitesCount}</p>
    </div>
  </div>

  <div class="mt-4 rounded-lg border border-slate-200 bg-white p-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-slate-600">
        상태 미점검이거나 오래된 사이트부터 최대 20개씩 재점검합니다. 여러 번 눌러 전체를 순회할 수 있어요.
      </p>
      <form method="post">
        <input type="hidden" name="action" value="recheck_stale" />
        <button type="submit" class="shrink-0 rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">
          상태 재점검 (최대 20개)
        </button>
      </form>
    </div>
  </div>

  <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
    <section>
      <h2 class="text-sm font-semibold text-slate-900">카테고리별 사이트 수</h2>
      <ul class="mt-3 space-y-1.5 rounded-lg border border-slate-200 bg-white p-4 text-sm">
        {stats.categoryBreakdown.map((c) => (
          <li class="flex items-center justify-between">
            <a href={`/category/${c.slug}`} class="text-slate-600 hover:underline">{c.name}</a>
            <span class="text-slate-400">{c.count}</span>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="text-sm font-semibold text-slate-900">최근 등록된 사이트</h2>
      <ul class="mt-3 space-y-2 rounded-lg border border-slate-200 bg-white p-4 text-sm">
        {stats.recentlyAdded.map((s) => (
          <li class="flex items-center justify-between gap-2">
            <a href={`/site/${s.slug}`} class="truncate text-slate-700 hover:underline">{s.name}</a>
            <span class="shrink-0 text-xs text-slate-400">{formatDate(s.created_at)}</span>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="text-sm font-semibold text-slate-900">조회수 상위 10</h2>
      <ul class="mt-3 space-y-2 rounded-lg border border-slate-200 bg-white p-4 text-sm">
        {stats.topByViews.map((s) => (
          <li class="flex items-center justify-between gap-2">
            <a href={`/site/${s.slug}`} class="truncate text-slate-700 hover:underline">{s.name}</a>
            <span class="shrink-0 text-xs text-slate-400">조회 {s.view_count}</span>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="text-sm font-semibold text-slate-900">방문 클릭 상위 10</h2>
      <ul class="mt-3 space-y-2 rounded-lg border border-slate-200 bg-white p-4 text-sm">
        {stats.topByClicks.map((s) => (
          <li class="flex items-center justify-between gap-2">
            <a href={`/site/${s.slug}`} class="truncate text-slate-700 hover:underline">{s.name}</a>
            <span class="shrink-0 text-xs text-slate-400">방문 {s.click_count}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>
