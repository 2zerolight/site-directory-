---
import { env } from 'cloudflare:workers';
import Layout from '../../../layouts/Layout.astro';
import { getSiteBySlug } from '../../../lib/db';
import { verifyOwnership } from '../../../lib/verify';
import { VERIFICATION_META_NAME, VERIFICATION_TXT_SUBDOMAIN } from '../../../lib/constants';

const { slug } = Astro.params;
const site = slug ? await getSiteBySlug(env.DB, slug) : null;

if (!site) {
  return Astro.redirect('/404');
}

let checkResult: { ok: boolean; method: 'meta_tag' | 'dns_txt' | null } | null = null;

if (Astro.request.method === 'POST' && !site.ownership_verified) {
  checkResult = await verifyOwnership(env.DB, site);
  if (checkResult.ok) {
    return Astro.redirect(`/submit/verify/${slug}`);
  }
}

const hostname = new URL(site.url).hostname;
const token = site.verification_token ?? '';
---

<Layout
  title="사이트 소유권 인증"
  description="사이트 소유권을 인증합니다."
  canonicalPath={`/submit/verify/${slug}`}
  noindex
>
  <h1 class="text-2xl font-bold text-slate-900">소유권 인증</h1>
  <p class="mt-2 text-slate-500">"{site.name}" ({hostname})의 소유자인지 확인합니다. 아래 두 방법 중 하나를 적용한 뒤 확인 버튼을 눌러주세요.</p>

  {site.ownership_verified ? (
    <div class="mt-6 rounded-md border border-green-200 bg-green-50 p-4 text-sm text-green-700">
      인증이 완료되었습니다 ({site.verification_method === 'meta_tag' ? '메타태그' : 'DNS TXT'} 방식). 관리자 검토 후 디렉토리에 노출됩니다.
    </div>
  ) : (
    <>
      {checkResult && !checkResult.ok && (
        <div class="mt-6 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-700">
          아직 인증을 확인하지 못했습니다. 아래 방법을 적용했는지 확인 후 다시 시도해주세요. (설정 반영까지 몇 분 걸릴 수 있습니다.)
        </div>
      )}

      <div class="mt-6 rounded-lg border border-slate-200 bg-white p-6 space-y-6">
        <div>
          <h2 class="font-semibold text-slate-900">방법 1. 메타태그 추가</h2>
          <p class="mt-1 text-sm text-slate-500">사이트 홈페이지 <code>&lt;head&gt;</code>에 아래 태그를 추가하세요.</p>
          <pre class="mt-2 overflow-x-auto rounded-md bg-slate-900 p-3 text-xs text-slate-100"><code>&lt;meta name="{VERIFICATION_META_NAME}" content="{token}" /&gt;</code></pre>
        </div>

        <div>
          <h2 class="font-semibold text-slate-900">방법 2. DNS TXT 레코드 추가</h2>
          <p class="mt-1 text-sm text-slate-500">도메인 DNS 설정에서 아래 TXT 레코드를 추가하세요.</p>
          <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
            <dt class="text-slate-400">호스트</dt>
            <dd class="font-mono">{VERIFICATION_TXT_SUBDOMAIN}.{hostname}</dd>
            <dt class="text-slate-400">타입</dt>
            <dd class="font-mono">TXT</dd>
            <dt class="text-slate-400">값</dt>
            <dd class="font-mono break-all">{token}</dd>
          </dl>
        </div>
      </div>

      <form method="post" class="mt-6">
        <button type="submit" class="rounded-md bg-slate-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-slate-700">
          지금 확인
        </button>
      </form>
    </>
  )}

  <p class="mt-8 text-xs text-slate-400">이 페이지 주소를 저장해두면 나중에 다시 방문해 인증 상태를 확인할 수 있습니다.</p>
</Layout>
