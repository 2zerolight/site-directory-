---
import { env } from 'cloudflare:workers';
import Layout from '../../../layouts/Layout.astro';
import { getSiteByVerificationSecret, touchVerifyAttempt } from '../../../lib/db';
import { verifyOwnership, remainingCooldown, VERIFY_COOLDOWN_SECONDS } from '../../../lib/verify';
import { renderNotFound } from '../../../lib/not-found';
import { VERIFICATION_META_NAME, VERIFICATION_TXT_SUBDOMAIN } from '../../../lib/constants';
import { decodeHostnameForDisplay } from '../../../lib/urls';

/*
  소유권 인증 셀프 서비스.

  이 페이지는 인증 토큰을 화면에 찍고, 버튼을 누르면 서버가 대상 사이트를 fetch 한다.
  예전에는 주소가 /submit/verify/{slug} 였는데 slug 는 상세 페이지 URL 이자 sitemap 에
  600개가 통째로 실린 공개 정보라, 주소만 조합하면 누구나 남의 인증 페이지를 열 수 있었다.
  그래서 한 번 통째로 닫았던 흐름이다.

  지금은 주소를 추측 불가능한 verification_secret 으로 잡는다. 제출한 사람만 이 주소를
  안다. 여기에 더해:

  - 익명 변경(예전의 "제 사이트가 아니에요")은 없앴다. 제3자 제출 여부는 등록 폼의
    체크박스로 받는다.
  - 확인 버튼에 쿨다운을 걸었다. 이게 없으면 시크릿을 아는 사람이 우리 서버를 시켜
    대상 사이트를 계속 두드리게 만들 수 있다.

  토큰이 노출되는 것 자체는 위험하지 않다. 인증을 통과하려면 그 토큰을 대상 도메인에
  올려야 하고, 그건 이미 그 도메인을 가진 사람만 할 수 있다.
*/
const { secret } = Astro.params;
const site = secret ? await getSiteByVerificationSecret(env.DB, secret) : null;

if (!site) {
  return renderNotFound(Astro);
}

let checkFailed = false;
let cooldownLeft = remainingCooldown(site.last_verify_attempt_at);

if (Astro.request.method === 'POST' && !site.ownership_verified) {
  if (cooldownLeft > 0) {
    checkFailed = false;
  } else {
    // fetch 하기 전에 찍는다. 나중에 찍으면 동시에 들어온 요청이 전부 통과한다.
    await touchVerifyAttempt(env.DB, site.id);
    const result = await verifyOwnership(env.DB, site);
    if (result.ok) {
      return Astro.redirect(`/submit/verify/${secret}`);
    }
    checkFailed = true;
    cooldownLeft = VERIFY_COOLDOWN_SECONDS;
  }
}

const hostname = decodeHostnameForDisplay(new URL(site.url).hostname);
const token = site.verification_token ?? '';
const verified = site.ownership_verified === 1;

// 토큰이 없으면 content="" 인 메타태그를 안내하게 되고, 그걸 넣어도 verifyOwnership 은
// 무조건 실패한다. 안내를 띄우는 대신 절대 통과할 수 없는 작업을 시키지 않는다.
// (등록 폼은 항상 토큰을 만들고 기존 데이터는 0002 마이그레이션에서 백필했으므로
//  실제로 걸릴 일은 없지만, 걸렸을 때 조용히 망가지는 쪽이 더 나쁘다)
const tokenMissing = token === '';
---

<Layout
  title="사이트 소유권 인증"
  description="사이트 소유권을 인증합니다."
  canonicalPath={`/submit/verify/${secret}`}
  noindex
>
  <h1 class="text-2xl font-bold text-slate-900">소유권 인증</h1>
  <p class="mt-2 text-slate-500">
    "{site.name}" ({hostname})의 소유자인지 확인합니다.
    {verified ? '' : ' 아래 두 방법 중 하나를 적용한 뒤 확인 버튼을 눌러주세요.'}
  </p>

  {verified ? (
    <div class="mt-6 rounded-md border border-green-200 bg-green-50 p-4 text-sm text-green-700">
      <p>
        인증이 완료되었습니다 ({site.verification_method === 'meta_tag' ? '메타태그' : 'DNS TXT'} 방식).
        {site.status === 'approved' ? '' : ' 관리자 검토 후 디렉토리에 노출됩니다.'}
      </p>
      {site.status === 'approved' && (
        <a
          href={`/badge/${site.slug}`}
          class="mt-3 inline-flex rounded-md bg-green-700 px-3 py-1.5 text-xs font-medium text-white hover:bg-green-800"
        >
          인증 배지 받기 →
        </a>
      )}
    </div>
  ) : (
    <>
      <p class="mt-1 text-sm text-slate-400">
        인증은 선택입니다. 하지 않아도 등록 검토는 그대로 진행되며, 인증하면 상세 페이지에 인증 배지를 달 수 있습니다.
      </p>

      {site.third_party_submission === 1 && (
        <div class="mt-6 rounded-md border border-blue-200 bg-blue-50 p-4 text-sm text-blue-700">
          소유자가 아닌 분이 제보한 사이트로 접수되었습니다. 관리자가 직접 확인한 뒤 승인 여부를 결정합니다.
          만약 이 사이트의 운영자시라면 아래 방법으로 지금 인증하실 수 있습니다.
        </div>
      )}

      {tokenMissing && (
        <div class="mt-6 rounded-md border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
          이 사이트의 인증값이 아직 발급되지 않았습니다. <a href="/contact" class="underline">문의</a>로 알려주시면 바로 발급해 드립니다.
        </div>
      )}

      {checkFailed && (
        <div class="mt-6 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-700">
          아직 인증을 확인하지 못했습니다. 아래 방법을 적용했는지 확인 후 다시 시도해주세요.
          (DNS 는 설정 반영까지 몇 분에서 몇 시간 걸릴 수 있습니다.)
        </div>
      )}

      {!tokenMissing && (
      <div class="mt-6 rounded-lg border border-slate-200 bg-white p-6 space-y-6">
        <div>
          <h2 class="font-semibold text-slate-900">방법 1. 메타태그 추가</h2>
          <p class="mt-1 text-sm text-slate-500">사이트 홈페이지 <code>&lt;head&gt;</code>에 아래 태그를 추가하세요.</p>
          <pre class="mt-2 overflow-x-auto rounded-md bg-slate-900 p-3 text-xs text-slate-100"><code>&lt;meta name="{VERIFICATION_META_NAME}" content="{token}" /&gt;</code></pre>
        </div>

        <div>
          <h2 class="font-semibold text-slate-900">방법 2. DNS TXT 레코드 추가</h2>
          <p class="mt-1 text-sm text-slate-500">도메인 DNS 설정에서 아래 TXT 레코드를 추가하세요.</p>
          <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
            <dt class="text-slate-400">호스트</dt>
            <dd class="font-mono break-all">{VERIFICATION_TXT_SUBDOMAIN}.{hostname}</dd>
            <dt class="text-slate-400">타입</dt>
            <dd class="font-mono">TXT</dd>
            <dt class="text-slate-400">값</dt>
            <dd class="font-mono break-all">{token}</dd>
          </dl>
        </div>
      </div>
      )}

      {!tokenMissing && (
      <form method="post" class="mt-6">
        <button
          type="submit"
          disabled={cooldownLeft > 0}
          class="rounded-md bg-slate-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-slate-700 disabled:cursor-not-allowed disabled:bg-slate-300"
        >
          {cooldownLeft > 0 ? `${cooldownLeft}초 후 다시 확인` : '지금 확인'}
        </button>
        {cooldownLeft > 0 && (
          <p class="mt-2 text-xs text-slate-400">
            확인은 {VERIFY_COOLDOWN_SECONDS}초에 한 번만 가능합니다. 페이지를 새로고침하면 남은 시간이 갱신됩니다.
          </p>
        )}
      </form>
      )}
    </>
  )}

  <p class="mt-8 text-xs text-slate-400">
    이 페이지 주소는 이 사이트의 인증 열쇠입니다. 저장해두면 나중에 다시 방문해 인증할 수 있고,
    다른 사람과 공유하지 마세요.
  </p>
</Layout>
