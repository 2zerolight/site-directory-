---
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import SiteCard from '../components/SiteCard.astro';
import { getCategoriesWithCounts, getRecentApprovedSites, getPopularApprovedSites, getPopularTags } from '../lib/db';
import { SITE_NAME, SITE_DESCRIPTION, SITE_URL, SITE_SAME_AS, CONTACT_EMAIL } from '../lib/site';

const [categories, recentSites, popularSites, popularTags] = await Promise.all([
  getCategoriesWithCounts(env.DB),
  getRecentApprovedSites(env.DB, 8),
  getPopularApprovedSites(env.DB, 8),
  getPopularTags(env.DB, 16),
]);

// 같은 이름(사이트다)을 쓰는 siteda.co.kr 과 구글이 우리를 헷갈리지 않게 하려면
// "사이트"만이 아니라 "누가 운영하는 무엇인가"를 개체로 선언해야 한다. Organization 을
// @id 로 고정하고 WebSite.publisher 가 그걸 가리키게 해서 둘을 한 그래프로 묶는다.
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#organization`,
  name: SITE_NAME,
  alternateName: 'siteda.kr',
  url: SITE_URL,
  description: SITE_DESCRIPTION,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/og-image.png`,
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: CONTACT_EMAIL,
    availableLanguage: ['ko'],
  },
  // 운영 채널이 생기기 전에는 빈 배열 대신 키 자체를 뺀다.
  ...(SITE_SAME_AS.length > 0 ? { sameAs: SITE_SAME_AS } : {}),
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  url: SITE_URL,
  inLanguage: 'ko',
  publisher: { '@id': `${SITE_URL}/#organization` },
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE_URL}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const jsonLd = [organizationJsonLd, websiteJsonLd];
---

<Layout title={`${SITE_NAME} – 국내 웹사이트 디렉토리`} description={SITE_DESCRIPTION} canonicalPath="/" jsonLd={jsonLd}>
  <section class="text-center py-8">
    <h1 class="text-3xl md:text-4xl font-bold text-slate-900">국내 웹사이트를 분야별로 발견하세요</h1>
    <p class="mt-3 text-slate-500 max-w-xl mx-auto">{SITE_DESCRIPTION}</p>
  </section>

  <section class="mt-6">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">카테고리</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {categories.map((category) => <CategoryCard category={category} />)}
    </div>
  </section>

  {popularSites.length > 0 && (
    <section class="mt-12">
      <h2 class="text-xl font-semibold text-slate-900 mb-4">인기 사이트</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {popularSites.map((site) => <SiteCard site={site} showVerifiedBadge={false} />)}
      </div>
    </section>
  )}

  {recentSites.length > 0 && (
    <section class="mt-12">
      <h2 class="text-xl font-semibold text-slate-900 mb-4">최근 등록된 사이트</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {recentSites.map((site) => <SiteCard site={site} showVerifiedBadge={false} />)}
      </div>
    </section>
  )}

  {popularTags.length > 0 && (
    <section class="mt-12">
      <h2 class="text-xl font-semibold text-slate-900 mb-4">인기 태그</h2>
      <div class="flex flex-wrap gap-2">
        {popularTags.map((tag) => (
          <a href={`/tag/${tag.slug}`} class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm text-slate-600 hover:border-slate-400 hover:text-slate-900">
            #{tag.name} <span class="text-slate-400">{tag.site_count}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>
