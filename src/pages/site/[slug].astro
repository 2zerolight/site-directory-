---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import SiteCard from '../../components/SiteCard.astro';
import AdBanner from '../../components/AdBanner.astro';
import {
  getSiteBySlug,
  getRelatedSites,
  getComparableSites,
  getTagsForSite,
  getApprovedReviewsForSite,
  getReviewStats,
  insertReview,
} from '../../lib/db';
import { SITE_URL, CONTACT_EMAIL } from '../../lib/site';
import { decodeHostnameForDisplay } from '../../lib/urls';
import { ADMIN_COOKIE_NAME, isValidSessionCookieValue } from '../../lib/auth';
import { renderNotFound } from '../../lib/not-found';
import { josa } from '../../lib/seo';

/*
  등록 시 사이트의 <title> 을 그대로 slug 로 만들어 마케팅 문구가 주소에 박힌 건들이
  있었다(예: 포포몬-no-1-무료-인플루언서-체험단-협찬매칭). 이름과 slug 를 브랜드명으로
  정리하면서 예전 주소가 죽지 않도록 301 로 넘긴다.

  카테고리 slug 를 바꿀 때 쓰던 OLD_CATEGORY_SLUG_REDIRECTS 와 같은 방식이다.
*/
const OLD_SITE_SLUG_REDIRECTS: Record<string, string> = {
  '리뷰노트-대한민국-체험단-수-1위-신뢰받는-리뷰-zyuinb': '리뷰노트-zyuinb',
  '당신의-리뷰가-마케팅이-되는-곳-리뷰플레이스-yezuq1': '리뷰플레이스-yezuq1',
  '포포몬-no-1-무료-인플루언서-체험단-협찬매칭-bbx5zo': '포포몬-bbx5zo',
  '아싸뷰-간편한-체험단-마케팅-플랫폼-op66vv': '아싸뷰-op66vv',
  '링블-당첨률-높은-체험단-사이트-n4irg0': '링블-n4irg0',
  '아이티이지-토탈-it-인프라-서비스-제공-기업-yystwm': '아이티이지-yystwm',
  '제이알미디어-라이브-중계-이원생중계-본딩-송출-전문-fsmhre': '제이알미디어-fsmhre',
  'ww2-kr-simple-fast-service-etvby4': 'ww2-kr-etvby4',
};

const { slug } = Astro.params;

if (slug && OLD_SITE_SLUG_REDIRECTS[slug]) {
  return Astro.redirect(`/site/${encodeURIComponent(OLD_SITE_SLUG_REDIRECTS[slug])}`, 301);
}

const site = slug ? await getSiteBySlug(env.DB, slug) : null;

if (!site) {
  return renderNotFound(Astro);
}

const isAdmin = await isValidSessionCookieValue(env.ADMIN_PASSWORD, Astro.cookies.get(ADMIN_COOKIE_NAME)?.value);
const isApproved = site.status === 'approved';

if (!isApproved && !isAdmin) {
  return renderNotFound(Astro);
}

let reviewSubmitted = false;
let reviewError = '';

if (Astro.request.method === 'POST' && isApproved) {
  const data = await Astro.request.formData();
  const honeypot = String(data.get('website') ?? '');
  const rating = Number(data.get('rating') ?? '');
  const comment = String(data.get('comment') ?? '').trim();
  const authorName = String(data.get('authorName') ?? '').trim();

  if (!honeypot) {
    if (!rating || rating < 1 || rating > 5) {
      reviewError = '별점을 선택해주세요.';
    } else if (!comment || comment.length > 1000) {
      reviewError = '리뷰 내용을 입력해주세요 (1000자 이내).';
    } else {
      let ipAddress: string | null = null;
      try {
        ipAddress = Astro.clientAddress;
      } catch {
        ipAddress = null;
      }
      const userAgent = Astro.request.headers.get('user-agent');
      await insertReview(env.DB, {
        siteId: site.id,
        rating,
        authorName: authorName || null,
        comment,
        ipAddress,
        userAgent,
      });
      reviewSubmitted = true;
    }
  } else {
    reviewSubmitted = true;
  }
}

const [relatedSites, comparableSites, tags, reviews, reviewStats] = await Promise.all([
  getRelatedSites(env.DB, site.category_id, site.id, 6),
  getComparableSites(env.DB, site, 4),
  getTagsForSite(env.DB, site.id),
  getApprovedReviewsForSite(env.DB, site.id),
  getReviewStats(env.DB, site.id),
]);

const hostname = decodeHostnameForDisplay(new URL(site.url).hostname);

const toChips = (raw: string | null) =>
  (raw ?? '')
    .split(',')
    .map((s) => s.trim())
    .filter(Boolean);

const serviceChips = toChips(site.service_keywords);
const keywordChips = toChips(site.main_keywords);

/*
  "비슷한 사이트와 뭐가 다른가" 비교표.

  디렉토리 상세 페이지가 원본 사이트를 이길 수 있는 거의 유일한 지점이다. 원본은
  자기 얘기만 하지 경쟁 서비스와 자기를 나란히 놓지 않는다. 표에 들어가는 값은 전부
  DB 에 저장된 사실(하는 일·유형·서비스 지역)이고 우열 판단은 넣지 않는다. 없는
  정보를 지어내면 그 순간 이 페이지는 원본보다 나쁜 페이지가 된다.

  비교 대상이 2곳 미만이면 표가 성립하지 않으므로 블록 자체를 렌더링하지 않는다.
*/
const comparisonRows = [site, ...comparableSites]
  .map((row) => ({
    slug: row.slug,
    name: row.name,
    isSelf: row.id === site.id,
    services: toChips(row.service_keywords),
    siteType: row.site_type,
    serviceRegion: row.service_region || row.region,
  }))
  .filter((row) => row.services.length > 0);

const showComparison = comparisonRows.length >= 3 && comparisonRows[0]?.isSelf === true;

const formatDate = (value: string | null) =>
  value ? new Date(value.replace(' ', 'T') + 'Z').toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' }) : null;

const registeredDate = formatDate(site.created_at);
const lastCheckedDate = formatDate(site.last_checked_at);

const isHealthy = site.http_status !== null && site.http_status >= 200 && site.http_status < 400;

const snsLinks = [
  { label: '블로그', url: site.blog_url },
  { label: '유튜브', url: site.youtube_url },
  { label: '인스타그램', url: site.instagram_url },
  { label: '페이스북', url: site.facebook_url },
  { label: '기타 SNS', url: site.other_sns_url },
].filter((link): link is { label: string; url: string } => Boolean(link.url));

const infoRows = [
  { label: '대분류', value: site.category_name },
  { label: '중분류', value: site.subcategory_name },
  { label: '사이트 유형', value: site.site_type },
  { label: '플랫폼', value: site.platform },
  { label: '지역', value: site.region },
  { label: '서비스 지역', value: site.service_region },
  { label: '운영 주체', value: site.operator_name },
  { label: '사업자명', value: site.business_name },
  { label: '고객센터', value: site.customer_center },
  { label: '이메일', value: site.contact_email },
].filter((row) => row.value);

const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: site.name,
  description: site.tagline || site.description,
  url: new URL(`/site/${site.slug}`, SITE_URL).toString(),
  about: {
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
  },
};

const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: '홈', item: SITE_URL },
  { '@type': 'ListItem', position: 2, name: site.category_name, item: new URL(`/category/${site.category_slug}`, SITE_URL).toString() },
];
if (site.subcategory_name) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 3,
    name: site.subcategory_name,
    item: new URL(`/category/${site.category_slug}?sub=${site.subcategory_slug}`, SITE_URL).toString(),
  });
}
breadcrumbItems.push({
  '@type': 'ListItem',
  position: breadcrumbItems.length + 1,
  name: site.name,
  item: new URL(`/site/${site.slug}`, SITE_URL).toString(),
});

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
};

const jsonLd = [webPageJsonLd, breadcrumbJsonLd];
---

<Layout
  title={site.name}
  description={site.tagline || site.description}
  canonicalPath={`/site/${site.slug}`}
  jsonLd={jsonLd}
  image={site.cover_image_url ?? undefined}
  noindex={!isApproved}
>
  {isApproved && <span data-view-slug={site.slug} hidden></span>}

  <nav class="text-sm text-slate-400 mb-4">
    <a href="/" class="hover:text-slate-600">홈</a> <span class="mx-1">/</span>
    <a href={`/category/${site.category_slug}`} class="hover:text-slate-600">{site.category_name}</a>
    {site.subcategory_name && (
      <>
        <span class="mx-1">/</span>
        <a href={`/category/${site.category_slug}?sub=${site.subcategory_slug}`} class="hover:text-slate-600">{site.subcategory_name}</a>
      </>
    )}
    <span class="mx-1">/</span> {site.name}
  </nav>

  {!isApproved && (
    <div class="mb-4 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-medium text-amber-700">
      관리자 미리보기: 이 사이트는 아직 {site.status === 'pending' ? '승인 대기 중' : '거절됨'}이라 공개 디렉토리에는 노출되지 않습니다.
    </div>
  )}

  {isAdmin && (
    <a
      href={`/dashboard?site=${site.id}#site-${site.id}`}
      class="mb-4 inline-flex items-center gap-1 rounded-md border border-blue-200 bg-blue-50 px-3 py-1.5 text-xs font-medium text-blue-700 hover:bg-blue-100"
    >
      관리자: 이 사이트 수정하기
    </a>
  )}

  <div class="rounded-lg border border-slate-200 bg-white p-5 sm:p-6 md:p-8">
    <div class="flex flex-col items-stretch gap-4 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
      <div class="flex min-w-0 items-start gap-3 sm:gap-4">
        {site.logo_url && (
          <img src={site.logo_url} alt={`${site.name} 로고`} class="w-14 h-14 rounded-md object-cover object-left bg-white border border-slate-100 shrink-0" loading="lazy" />
        )}
        <div class="min-w-0">
          <h1 class="text-2xl font-bold text-slate-900 break-words">{site.name}</h1>
          <p class="mt-1 text-sm text-slate-500 break-words">{hostname}</p>
          {site.tagline && <p class="mt-2 text-slate-700 font-medium break-words">{site.tagline}</p>}
          {reviewStats.count > 0 && (
            <p class="mt-1 text-sm text-amber-600">★ {reviewStats.avg.toFixed(1)} <span class="text-slate-400">({reviewStats.count}개 리뷰)</span></p>
          )}
        </div>
      </div>
      <div class="flex w-full shrink-0 gap-2 sm:w-auto">
        <button
          type="button"
          data-bookmark-toggle
          data-site-id={site.id}
          class="shrink-0 rounded-md border border-slate-200 px-3 py-2.5 text-sm text-slate-500 hover:border-slate-400 hover:text-slate-900"
          aria-label="즐겨찾기"
        >
          <span data-bookmark-icon>☆</span>
        </button>
        <button
          type="button"
          data-share-button
          data-share-title={site.name}
          data-share-text={site.tagline}
          data-share-url={new URL(`/site/${site.slug}`, SITE_URL).toString()}
          class="shrink-0 rounded-md border border-slate-200 px-3 py-2.5 text-sm text-slate-500 hover:border-slate-400 hover:text-slate-900"
          aria-label="공유하기"
        >
          <span data-share-label>공유</span>
        </button>
        <a
          href={`/go/${site.slug}`}
          target="_blank"
          rel="nofollow noopener noreferrer sponsored"
          class="min-w-0 flex-1 rounded-md bg-slate-900 px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-slate-700 sm:flex-none"
        >
          공식 홈페이지 방문 →
        </a>
      </div>
    </div>

    <div class="mt-4 flex flex-wrap gap-2 text-xs">
      <span class={`rounded-full px-2.5 py-1 ${isHealthy ? 'bg-green-100 text-green-700' : 'bg-slate-100 text-slate-500'}`}>
        {isHealthy ? '정상 접속 확인됨' : site.http_status ? `접속 오류 (${site.http_status})` : '접속 상태 미확인'}
      </span>
      <span class={`rounded-full px-2.5 py-1 ${site.is_https ? 'bg-green-100 text-green-700' : 'bg-slate-100 text-slate-500'}`}>
        {site.is_https ? 'HTTPS 보안 연결' : 'HTTPS 미확인'}
      </span>
      {/*
        '소유권 인증됨' 은 메타태그/DNS 로 도메인 통제를 실제 검증한 경우에만 쓴다.
        관리자가 눈으로 확인만 한 건은 근거가 다르므로 '운영자 확인됨' 으로 구분한다.
      */}
      <span
        title={site.ownership_verified
          ? site.verified_by_admin
            ? '운영자 정보를 관리자가 확인했습니다. 도메인 소유권 검증은 거치지 않았습니다.'
            : '메타태그 또는 DNS TXT 레코드로 도메인 소유권을 검증했습니다.'
          : '도메인 소유권이 아직 검증되지 않았습니다.'}
        class={`rounded-full px-2.5 py-1 ${site.ownership_verified ? 'bg-blue-100 text-blue-700' : 'bg-slate-100 text-slate-500'}`}
      >
        {site.ownership_verified
          ? site.verified_by_admin
            ? '운영자 확인됨'
            : '소유권 인증됨'
          : '소유권 미인증'}
      </span>
    </div>

    {site.description && (
      <p class="mt-6 text-slate-700 leading-relaxed whitespace-pre-line break-words">{site.description}</p>
    )}

    {/*
      대표 이미지(보통 원본 사이트의 og:image)는 예전에 페이지 맨 위에 가로로 꽉 채워
      깔았는데, 정보가 아닌 남의 홍보 배너가 제목보다 먼저 보이는 꼴이라 효과가 없었다.
      지금은 주요 서비스·키워드 옆에 작은 미리보기로만 둔다.
    */}
    {(serviceChips.length > 0 || keywordChips.length > 0 || tags.length > 0 || site.cover_image_url) && (
      <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
        <div class="min-w-0 flex-1">
          {serviceChips.length > 0 && (
            <div>
              <h2 class="text-sm font-semibold text-slate-900">주요 서비스</h2>
              <div class="mt-2 flex flex-wrap gap-2">
                {serviceChips.map((chip) => (
                  <span class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-600">{chip}</span>
                ))}
              </div>
            </div>
          )}

          {keywordChips.length > 0 && (
            <div class={serviceChips.length > 0 ? 'mt-4' : ''}>
              <h2 class="text-sm font-semibold text-slate-900">주요 키워드</h2>
              <div class="mt-2 flex flex-wrap gap-2">
                {keywordChips.map((chip) => (
                  <span class="rounded-full border border-slate-200 px-3 py-1 text-xs text-slate-500">#{chip}</span>
                ))}
              </div>
            </div>
          )}

          {tags.length > 0 && (
            <div class={serviceChips.length > 0 || keywordChips.length > 0 ? 'mt-4' : ''}>
              <div class="flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <a href={`/tag/${tag.slug}`} class="rounded-full bg-slate-900 px-3 py-1 text-xs text-white hover:bg-slate-700">#{tag.name}</a>
                ))}
              </div>
            </div>
          )}
        </div>

        {site.cover_image_url && (
          <a
            href={`/go/${site.slug}`}
            target="_blank"
            rel="nofollow noopener noreferrer sponsored"
            class="block w-full max-w-[14rem] shrink-0 sm:w-56"
            title={`${site.name} 방문`}
          >
            <img
              src={site.cover_image_url}
              alt={`${site.name} 대표 이미지`}
              class="aspect-[1200/630] w-full rounded-md border border-slate-200 bg-slate-50 object-cover"
              loading="lazy"
            />
          </a>
        )}
      </div>
    )}

    {infoRows.length > 0 && (
      <dl class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 border-t border-slate-100 pt-6 text-sm">
        {infoRows.map((row) => (
          <div class="flex gap-2">
            <dt class="w-20 shrink-0 text-slate-400">{row.label}</dt>
            <dd class="text-slate-700">{row.value}</dd>
          </div>
        ))}
      </dl>
    )}

    {snsLinks.length > 0 && (
      <div class="mt-6 border-t border-slate-100 pt-6">
        <h2 class="text-sm font-semibold text-slate-900">SNS</h2>
        <div class="mt-2 flex flex-wrap gap-3">
          {snsLinks.map((link) => (
            <a href={link.url} target="_blank" rel="nofollow noopener noreferrer" class="text-sm text-slate-500 underline hover:text-slate-900">
              {link.label}
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="mt-6 flex flex-wrap gap-4 border-t border-slate-100 pt-6 text-xs text-slate-400">
      {registeredDate && <span>등록일 {registeredDate}</span>}
      {lastCheckedDate && <span>최종 확인일 {lastCheckedDate}</span>}
      <span>조회 {site.view_count}</span>
      <span>방문 {site.click_count}</span>
    </div>

    {/*
      예전에는 여기서 인증 페이지로 바로 보냈는데, 그 링크가 공개돼 있으면 누구나
      남의 인증 토큰을 읽고 등록 상태를 바꿀 수 있었다. 이제는 연락을 받아 관리자가
      직접 처리하므로 안내만 남긴다.
    */}
    {isApproved && !site.ownership_verified && (
      <p class="mt-4 text-xs text-slate-400">
        이 사이트 운영자세요? 소유권을 인증하면 인증 배지를 무료로 받으실 수 있습니다.
        <a href={`mailto:${CONTACT_EMAIL}`} class="underline underline-offset-2 hover:text-slate-600">{CONTACT_EMAIL}</a>로 알려주세요.
      </p>
    )}

    {isApproved && (
      <div class="mt-6 border-t border-slate-100 pt-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-sm font-semibold text-slate-900">
          리뷰 {reviewStats.count > 0 && <span class="text-slate-400 font-normal">({reviewStats.count})</span>}
        </h2>
        <button
          type="button"
          data-helpful-button
          data-site-id={site.id}
          class="flex items-center gap-1.5 rounded-full border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-500 hover:border-slate-400 hover:text-slate-900"
        >
          👍 <span>유용해요</span> <span data-helpful-count>{site.helpful_count > 0 ? `(${site.helpful_count})` : ''}</span>
        </button>
      </div>

      {reviews.length === 0 ? (
        <p class="mt-3 text-sm text-slate-400">아직 리뷰가 없습니다. 첫 리뷰를 남겨보세요.</p>
      ) : (
        <ul class="mt-4 space-y-4">
          {reviews.map((review) => (
            <li class="border-t border-slate-100 pt-4 first:border-t-0 first:pt-0">
              <div class="flex items-center gap-2 text-sm">
                <span class="text-amber-500">{'★'.repeat(review.rating)}{'☆'.repeat(5 - review.rating)}</span>
                <span class="text-slate-400">{review.author_name || '익명'}</span>
              </div>
              <p class="mt-1 text-sm text-slate-700 whitespace-pre-line break-words">{review.comment}</p>
            </li>
          ))}
        </ul>
      )}

      <div class="mt-6 border-t border-slate-100 pt-6">
        {reviewSubmitted ? (
          <p class="text-sm text-green-700">리뷰가 접수되었습니다. 검토 후 게시됩니다. 감사합니다!</p>
        ) : (
          <details open={!!reviewError}>
            <summary class="cursor-pointer text-sm font-medium text-slate-700 hover:text-slate-900">리뷰 남기기</summary>
            <form method="post" class="mt-4 space-y-3">
            <div>
              <label class="block text-sm font-medium text-slate-700">별점<span class="ml-0.5 text-rose-500">*</span></label>
              <div class="star-rating mt-1 inline-flex flex-row-reverse items-center justify-end">
                {[5, 4, 3, 2, 1].map((n) => (
                  <>
                    <input type="radio" name="rating" id={`rating-${n}`} value={n} required />
                    <label for={`rating-${n}`} aria-label={`${n}점`} title={`${n}점`}>★</label>
                  </>
                ))}
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700" for="review-comment">리뷰 내용</label>
              <textarea
                id="review-comment" name="comment" required maxlength="1000" rows="3"
                class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
              ></textarea>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700" for="review-name">이름 (선택)</label>
              <input
                id="review-name" name="authorName" type="text" maxlength="30"
                class="mt-1 w-full max-w-xs rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
              />
            </div>
            <div class="hidden" aria-hidden="true">
              <label for="review-website">Website</label>
              <input id="review-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>
            {reviewError && <p class="text-sm text-rose-600">{reviewError}</p>}
            <button type="submit" class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">
              등록하기
            </button>
            </form>
          </details>
        )}
      </div>
      </div>
    )}
  </div>

  <AdBanner class="mt-10" />

  {showComparison && (
    <section class="mt-10">
      <h2 class="text-lg font-semibold text-slate-900">
        {site.name}{josa(site.name, '과', '와')} 비슷한 사이트, 뭐가 다른가
      </h2>
      <p class="mt-1 text-sm text-slate-500">
        {site.category_name} 분야에서 {site.name}{josa(site.name, '과', '와')} 가장 가까운
        {comparisonRows.length - 1}곳을 나란히 놓고 각각 무엇을 하는 곳인지 비교했습니다.
      </p>

      <div class="mt-4 overflow-x-auto">
        <table class="w-full min-w-[36rem] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-slate-200 text-xs uppercase tracking-wide text-slate-400">
              <th scope="col" class="py-2 pr-4 font-medium">사이트</th>
              <th scope="col" class="py-2 pr-4 font-medium">하는 일</th>
              <th scope="col" class="py-2 pr-4 font-medium">유형</th>
              <th scope="col" class="py-2 font-medium">서비스 지역</th>
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map((row) => (
              <tr class={`border-b border-slate-100 align-top ${row.isSelf ? 'bg-slate-50' : ''}`}>
                <th scope="row" class="py-3 pr-4 font-medium text-slate-900">
                  {row.isSelf ? (
                    <span>{row.name} <span class="ml-1 text-xs font-normal text-slate-400">(이 페이지)</span></span>
                  ) : (
                    <a href={`/site/${row.slug}`} class="hover:underline">{row.name}</a>
                  )}
                </th>
                <td class="py-3 pr-4 text-slate-700">{row.services.join(', ')}</td>
                <td class="py-3 pr-4 text-slate-500">{row.siteType ?? '-'}</td>
                <td class="py-3 text-slate-500">{row.serviceRegion ?? '-'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="mt-3 text-xs text-slate-400">
        표의 값은 사이트다에 등록된 정보를 그대로 옮긴 것입니다. 우열을 매기지 않으며,
        각 서비스의 최신 내용은 해당 사이트에서 확인하세요.
      </p>
    </section>
  )}

  {relatedSites.length > 0 && (
    <section class="mt-10">
      <h2 class="text-lg font-semibold text-slate-900 mb-4">같은 카테고리의 다른 사이트</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {relatedSites.map((related) => <SiteCard site={related} showCategory={false} />)}
      </div>
    </section>
  )}
</Layout>

<script>
  // 조회수는 서버 렌더링이 아니라 여기서 올린다. /site/ 가 엣지에서 캐시되기
  // 때문에 서버에서 세면 캐시 히트인 요청이 통째로 누락된다.
  const slug = document.querySelector<HTMLElement>('[data-view-slug]')?.dataset.viewSlug;
  if (slug) {
    fetch('/api/track-view', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ slug }),
      keepalive: true,
    }).catch(() => {
      // 집계 실패는 페이지 동작과 무관하므로 조용히 넘어간다
    });
  }
</script>

<style>
  .star-rating input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .star-rating label {
    cursor: pointer;
    font-size: 1.75rem;
    line-height: 1;
    color: #cbd5e1;
    transition: color 0.1s ease;
  }
  .star-rating input:checked ~ label,
  .star-rating label:hover,
  .star-rating label:hover ~ label {
    color: #f59e0b;
  }
  .star-rating input:focus-visible ~ label {
    outline: 2px solid #0f172a;
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
