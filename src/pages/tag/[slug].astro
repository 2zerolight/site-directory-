---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import SiteCard from '../../components/SiteCard.astro';
import { getApprovedSitesByTag, PAGE_SIZE } from '../../lib/db';
import { SITE_URL } from '../../lib/site';
import { renderNotFound } from '../../lib/not-found';
import { buildListDescription } from '../../lib/seo';

const { slug } = Astro.params;
const page = Math.max(1, Number(Astro.url.searchParams.get('page') ?? '1') || 1);
const { sites, total, tag } = slug ? await getApprovedSitesByTag(env.DB, slug, page) : { sites: [], total: 0, tag: null };

if (!tag) {
  return renderNotFound(Astro);
}

// 승인된 사이트가 하나도 없는 태그는 목록이 아니라 빈 페이지다. 거절·삭제된 사이트에
// 붙어 있던 태그가 이렇게 남는다(캐스퍼차고 중복 등록 건에서 6개 발견). 사이트맵에는
// 안 실리지만 주소로는 열려서 "0개"짜리 색인 대상이 되므로 404 로 끊는다.
if (total === 0) {
  return renderNotFound(Astro);
}

const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

// self-canonical 로 바꾼 뒤로 ?page=99 같은 범위 밖 페이지까지 자기 자신을 canonical 로
// 선언하는 색인 대상이 됐다. 내용은 비어 있으므로 그대로 두면 목록마다 무한히 많은 빈
// URL 이 색인 후보로 노출된다. 범위를 벗어나면 404 로 끊는다.
if (page > totalPages) {
  return renderNotFound(Astro);
}

// 카테고리 페이지와 같은 이유. 2페이지 이상은 self-canonical 이므로 제목/설명이
// 1페이지와 겹치면 중복 제목으로 잡힌다.
const canonicalPath = page > 1 ? `/tag/${tag.slug}?page=${page}` : `/tag/${tag.slug}`;
const pageSuffix = page > 1 ? ` (${page}페이지)` : '';
const intro = `#${tag.name} 태그가 붙은 국내 웹사이트 모음`;
const description = buildListDescription(
  `#${tag.name} 태그가 붙은 국내 웹사이트 ${total}개${pageSuffix}`,
  sites.map((site) => site.name)
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `#${tag.name} 사이트 목록${pageSuffix}`,
  url: new URL(canonicalPath, SITE_URL).toString(),
  itemListElement: sites.map((site, index) => ({
    '@type': 'ListItem',
    position: (page - 1) * PAGE_SIZE + index + 1,
    url: new URL(`/site/${site.slug}`, SITE_URL).toString(),
    name: site.name,
  })),
};
---

<Layout title={`#${tag.name}${pageSuffix}`} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <nav class="text-sm text-slate-400 mb-4">
    <a href="/" class="hover:text-slate-600">홈</a> <span class="mx-1">/</span> #{tag.name}
  </nav>

  <h1 class="text-2xl font-bold text-slate-900">#{tag.name}</h1>
  <p class="mt-2 text-slate-500">{intro}</p>
  <p class="mt-1 text-sm text-slate-400">{total}개 사이트</p>

  {sites.length === 0 ? (
    <p class="mt-10 text-slate-400">아직 이 태그가 붙은 사이트가 없습니다.</p>
  ) : (
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {sites.map((site) => <SiteCard site={site} showCategory={true} />)}
    </div>
  )}

  {totalPages > 1 && (
    <nav class="mt-10 flex items-center justify-center gap-2 text-sm">
      {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
        <a
          href={`/tag/${tag.slug}${p > 1 ? `?page=${p}` : ''}`}
          class={`rounded-md px-3 py-1.5 border ${p === page ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-300 text-slate-600 hover:border-slate-500'}`}
        >
          {p}
        </a>
      ))}
    </nav>
  )}
</Layout>
