---
import { env } from 'cloudflare:workers';
import Layout from '../../../layouts/Layout.astro';
import { getSiteBySlug } from '../../../lib/db';
import { renderNotFound } from '../../../lib/not-found';
import { decodeHostnameForDisplay } from '../../../lib/urls';
import {
  BADGE_STYLES,
  BADGE_THEMES,
  badgeAltText,
  badgeImageUrl,
  badgeLinkUrl,
  renderBadgeSvg,
  type BadgeStyle,
  type BadgeTheme,
} from '../../../lib/badge';

const { slug } = Astro.params;
const site = slug ? await getSiteBySlug(env.DB, slug) : null;

if (!site || site.status !== 'approved') {
  return renderNotFound(Astro);
}

const verified = site.ownership_verified === 1;
const hostname = decodeHostnameForDisplay(new URL(site.url).hostname);
const linkUrl = badgeLinkUrl(site.slug);
const altText = badgeAltText(site.name, verified);

type CheckResult = 'found' | 'missing' | 'error';
let checkResult: CheckResult | null = null;

if (Astro.request.method === 'POST') {
  try {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 8000);
    const response = await fetch(site.url, { redirect: 'follow', signal: controller.signal });
    clearTimeout(timeoutId);
    const html = await response.text();
    const encodedSlug = encodeURIComponent(site.slug);
    checkResult =
      html.includes(`/site/${encodedSlug}`) || html.includes(`/site/${site.slug}`) ? 'found' : 'missing';
  } catch {
    checkResult = 'error';
  }
}

const STYLE_LABELS: Record<BadgeStyle, string> = {
  standard: '기본',
  compact: '컴팩트',
  seal: '씰',
};

const THEME_LABELS: Record<BadgeTheme, string> = {
  light: '라이트',
  dark: '다크',
};

function dimensions(svg: string): { width: string; height: string } {
  const match = svg.match(/width="(\d+)" height="(\d+)"/);
  return { width: match?.[1] ?? '', height: match?.[2] ?? '' };
}

const variants = BADGE_STYLES.flatMap((style) =>
  BADGE_THEMES.map((theme) => {
    const svg = renderBadgeSvg({ verified, style, theme }, altText);
    const { width, height } = dimensions(svg);
    const imgSnippet = `<a href="${linkUrl}" target="_blank" rel="noopener">
  <img src="${badgeImageUrl(site.slug, style, theme)}"
       alt="${altText}"
       width="${width}" height="${height}" loading="lazy">
</a>`;
    const inlineSnippet = `<a href="${linkUrl}" target="_blank" rel="noopener" aria-label="${altText}">
${svg
  .split('\n')
  .map((line) => `  ${line}`)
  .join('\n')}
</a>`;
    return { key: `${style}-${theme}`, style, theme, svg, imgSnippet, inlineSnippet };
  })
);

const defaultKey = 'standard-light';
const formatDate = (value: string | null) =>
  value
    ? new Date(value.replace(' ', 'T') + 'Z').toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })
    : null;
const verifiedDate = formatDate(site.verified_at);
---

<Layout
  title={`${site.name} 인증 배지`}
  description={`${site.name}의 사이트다 인증 배지를 내 사이트에 설치하세요.`}
  canonicalPath={`/badge/${site.slug}`}
  noindex
>
  <nav class="text-sm text-slate-400 mb-4">
    <a href="/" class="hover:text-slate-600">홈</a> <span class="mx-1">/</span>
    <a href={`/site/${site.slug}`} class="hover:text-slate-600">{site.name}</a>
    <span class="mx-1">/</span> 인증 배지
  </nav>

  <h1 class="text-2xl font-bold text-slate-900">인증 배지</h1>
  <p class="mt-2 text-slate-500">
    <span class="font-medium text-slate-700">{site.name}</span> · {hostname}
  </p>
  <p class="mt-1 text-sm text-slate-400">
    내 사이트 하단이나 소개 페이지에 붙이면, 방문자가 배지를 눌러 사이트다의 등록 정보를 바로 확인할 수 있습니다.
  </p>

  {verified ? (
    <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 rounded-md border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800">
      <span class="font-semibold">소유권 인증 완료</span>
      <span class="text-blue-600">
        {site.verification_method === 'meta_tag' ? '메타태그' : 'DNS TXT'} 방식
        {verifiedDate && ` · ${verifiedDate} 확인`}
      </span>
      <span class="w-full text-xs text-blue-600">월계관 안에 인증 체크가 그려집니다 — 인증된 사이트에만 발급됩니다.</span>
    </div>
  ) : (
    <div class="mt-6 rounded-lg border border-amber-200 bg-amber-50 p-5">
      <p class="font-semibold text-amber-900">소유권 인증을 마쳐야 배지를 발급합니다</p>
      <p class="mt-2 text-sm text-amber-800">
        배지는 “이 도메인의 소유자가 확인되었다”는 표시입니다. 확인 절차 없이 내주면 표시 자체의 신뢰가 없어지기 때문에,
        메타태그나 DNS TXT로 <span class="font-medium">{hostname}</span>의 소유를 확인한 뒤에만 설치 코드를 드립니다.
      </p>
      <p class="mt-2 text-sm text-amber-800">인증은 몇 분이면 끝나고, 끝나는 즉시 이 페이지에서 코드를 받을 수 있습니다.</p>
      <a
        href={`/submit/verify/${site.slug}`}
        class="mt-4 inline-flex rounded-md bg-amber-600 px-4 py-2 text-sm font-medium text-white hover:bg-amber-700"
      >
        소유권 인증하러 가기 →
      </a>
      <p class="mt-4 border-t border-amber-200 pt-3 text-xs text-amber-700">
        인증과 무관하게 <a href={`/site/${site.slug}`} class="underline">등록 정보 페이지</a>는 이미 공개되어 있습니다.
      </p>
    </div>
  )}

  {verified && (
  <>
    <section class="mt-8 rounded-lg border border-slate-200 bg-white p-5 sm:p-6">
      <h2 class="text-sm font-semibold text-slate-900">1. 배지 고르기</h2>

      <div class="mt-4 flex flex-wrap gap-6">
        <div>
          <p class="text-xs font-medium text-slate-400">스타일</p>
          <div class="mt-1.5 flex gap-1.5" data-badge-group="style">
            {BADGE_STYLES.map((style) => (
              <button
                type="button"
                data-badge-option={style}
                class="rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-600 hover:border-slate-500"
              >
                {STYLE_LABELS[style]}
              </button>
            ))}
          </div>
        </div>

        <div>
          <p class="text-xs font-medium text-slate-400">테마</p>
          <div class="mt-1.5 flex gap-1.5" data-badge-group="theme">
            {BADGE_THEMES.map((theme) => (
              <button
                type="button"
                data-badge-option={theme}
                class="rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-600 hover:border-slate-500"
              >
                {THEME_LABELS[theme]}
              </button>
            ))}
          </div>
        </div>
      </div>

      <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div class="flex min-h-28 items-center justify-center rounded-md border border-slate-200 bg-slate-50 p-5">
          {variants.map((v) => (
            <div data-preview={v.key} hidden={v.key !== defaultKey} set:html={v.svg} />
          ))}
        </div>
        <div class="flex min-h-28 items-center justify-center rounded-md border border-slate-800 bg-slate-900 p-5">
          {variants.map((v) => (
            <div data-preview-dark={v.key} hidden={v.key !== defaultKey} set:html={v.svg} />
          ))}
        </div>
      </div>
      <p class="mt-2 text-xs text-slate-400">왼쪽은 밝은 배경, 오른쪽은 어두운 배경에 올렸을 때의 모습입니다.</p>
    </section>

    <section class="mt-6 rounded-lg border border-slate-200 bg-white p-5 sm:p-6">
      <h2 class="text-sm font-semibold text-slate-900">2. 코드 붙여넣기</h2>

      <div class="mt-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h3 class="text-sm font-medium text-slate-700">
            이미지 태그 <span class="ml-1 rounded-full bg-slate-900 px-2 py-0.5 text-[10px] font-medium text-white">권장</span>
          </h3>
          <button
            type="button"
            data-copy-from="snippet-img"
            class="rounded-md border border-slate-300 px-2.5 py-1 text-xs text-slate-600 hover:border-slate-500"
          >
            <span data-copy-label>복사</span>
          </button>
        </div>
        <p class="mt-1 text-xs text-slate-400">인증 상태가 바뀌면 배지 모양이 자동으로 갱신됩니다.</p>
        {variants.map((v) => (
          <pre
            id={v.key === defaultKey ? 'snippet-img' : undefined}
            data-snippet-img={v.key}
            hidden={v.key !== defaultKey}
            class="mt-2 overflow-x-auto rounded-md bg-slate-900 p-3 text-xs leading-relaxed text-slate-100"
          ><code>{v.imgSnippet}</code></pre>
        ))}
      </div>

      <details class="mt-5 border-t border-slate-100 pt-4">
        <summary class="cursor-pointer text-sm font-medium text-slate-700 hover:text-slate-900">
          인라인 SVG로 넣기 (사이트다 서버에 요청하지 않음)
        </summary>
        <p class="mt-2 text-xs text-slate-400">
          외부 이미지 요청이 없어 가장 빠릅니다. 대신 인증 상태가 바뀌어도 코드를 다시 붙여넣기 전까지 모양이 그대로입니다.
        </p>
        <div class="mt-3 flex justify-end">
          <button
            type="button"
            data-copy-from="snippet-inline"
            class="rounded-md border border-slate-300 px-2.5 py-1 text-xs text-slate-600 hover:border-slate-500"
          >
            <span data-copy-label>복사</span>
          </button>
        </div>
        {variants.map((v) => (
          <pre
            id={v.key === defaultKey ? 'snippet-inline' : undefined}
            data-snippet-inline={v.key}
            hidden={v.key !== defaultKey}
            class="mt-2 max-h-72 overflow-auto rounded-md bg-slate-900 p-3 text-xs leading-relaxed text-slate-100"
          ><code>{v.inlineSnippet}</code></pre>
        ))}
      </details>
    </section>

    <section class="mt-6 rounded-lg border border-slate-200 bg-white p-5 sm:p-6">
      <h2 class="text-sm font-semibold text-slate-900">3. 설치 확인</h2>
      <p class="mt-1 text-sm text-slate-500">
        {hostname} 첫 화면에서 이 사이트의 배지 링크를 찾아봅니다.
      </p>

      {checkResult === 'found' && (
        <p class="mt-3 rounded-md border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-700">
          배지 링크를 찾았습니다. 설치가 완료되었습니다.
        </p>
      )}
      {checkResult === 'missing' && (
        <p class="mt-3 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-700">
          첫 화면에서 링크를 찾지 못했습니다. 하위 페이지에만 넣으셨다면 정상입니다. 캐시 때문에 잠시 뒤 잡히기도 합니다.
        </p>
      )}
      {checkResult === 'error' && (
        <p class="mt-3 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
          사이트에 접속하지 못했습니다. 잠시 후 다시 시도해주세요.
        </p>
      )}

      <form method="post" class="mt-3">
        <button type="submit" class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">
          지금 확인
        </button>
      </form>
    </section>

    <section class="mt-6 rounded-lg border border-slate-200 bg-slate-50 p-5 sm:p-6">
      <h2 class="text-sm font-semibold text-slate-900">알아두실 점</h2>
      <ul class="mt-3 space-y-2 text-sm text-slate-600">
        <li>· 배지 링크는 <span class="font-mono text-xs text-slate-800">{linkUrl}</span> 로 고정되어 있습니다. 사이트다 홈이 아니라 이 상세 페이지로 걸어야 방문자가 등록 정보를 바로 확인할 수 있습니다.</li>
        <li>· 등록과 배지 사용은 무료이며 상호 링크를 조건으로 하지 않습니다. 그래서 <span class="font-mono text-xs text-slate-800">nofollow</span> 없이 일반 링크로 제공합니다.</li>
        <li>· 배지에는 한글 문구가 없습니다. 의미는 alt 텍스트(“사이트명 · 사이트다 인증된 등록 사이트”)가 담으며, 브랜드명은 고정이고 사이트명만 변수라 같은 키워드로 바꿔 넣지 마세요.</li>
        <li>· 배지를 내리셔도 등록은 유지됩니다. 등록 삭제는 <a href="/faq" class="underline hover:text-slate-900">자주 묻는 질문</a>을 참고해주세요.</li>
      </ul>
    </section>
  </>
  )}
</Layout>

<script>
  const state = { style: 'standard', theme: 'light' };

  function currentKey(): string {
    return `${state.style}-${state.theme}`;
  }

  function syncGroup(group: HTMLElement, active: string) {
    group.querySelectorAll<HTMLElement>('[data-badge-option]').forEach((button) => {
      const on = button.dataset.badgeOption === active;
      button.classList.toggle('border-slate-900', on);
      button.classList.toggle('bg-slate-900', on);
      button.classList.toggle('text-white', on);
      button.classList.toggle('text-slate-600', !on);
      button.setAttribute('aria-pressed', String(on));
    });
  }

  function syncPanels() {
    const key = currentKey();
    const selectors = ['data-preview', 'data-preview-dark', 'data-snippet-img', 'data-snippet-inline'];

    selectors.forEach((attr) => {
      document.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((el) => {
        const match = el.getAttribute(attr) === key;
        el.hidden = !match;
        // The copy buttons target a stable id, so hand it to whichever panel is live.
        if (attr === 'data-snippet-img' || attr === 'data-snippet-inline') {
          const id = attr === 'data-snippet-img' ? 'snippet-img' : 'snippet-inline';
          if (match) el.id = id;
          else if (el.id === id) el.removeAttribute('id');
        }
      });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-badge-group]').forEach((group) => {
    const name = group.dataset.badgeGroup as 'style' | 'theme';
    group.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-badge-option]');
      if (!button) return;
      state[name] = button.dataset.badgeOption ?? state[name];
      syncGroup(group, state[name]);
      syncPanels();
    });
    syncGroup(group, state[name]);
  });

  syncPanels();

  document.querySelectorAll<HTMLElement>('[data-copy-from]').forEach((button) => {
    button.addEventListener('click', async () => {
      const target = document.getElementById(button.dataset.copyFrom ?? '');
      const label = button.querySelector('[data-copy-label]');
      if (!target?.textContent) return;
      try {
        await navigator.clipboard.writeText(target.textContent);
        if (label) {
          label.textContent = '복사됨!';
          setTimeout(() => {
            label.textContent = '복사';
          }, 1500);
        }
      } catch {
        // clipboard unavailable; the code block is selectable by hand
      }
    });
  });
</script>
