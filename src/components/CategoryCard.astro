---
import type { CategoryWithCount } from '../types';

interface Props {
  category: CategoryWithCount;
}

const { category } = Astro.props;
---

<a
  href={`/category/${category.slug}`}
  class="block rounded-lg border border-slate-200 bg-white p-5 hover:border-slate-400 hover:shadow-sm transition"
>
  <h3 class="font-semibold text-slate-900">{category.name}</h3>
  <p class="mt-1 text-sm text-slate-500 line-clamp-2">{category.description}</p>
  <p class="mt-3 text-xs font-medium text-slate-400">{category.site_count}개 사이트</p>
</a>
