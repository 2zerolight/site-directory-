---
import type { SiteWithCategory } from '../types';

interface Props {
  site: SiteWithCategory;
  showCategory?: boolean;
}

const { site, showCategory = true } = Astro.props;
---

<a
  href={`/site/${site.slug}`}
  class="block rounded-lg border border-slate-200 bg-white p-5 hover:border-slate-400 hover:shadow-sm transition"
>
  <div class="flex items-start gap-3">
    {site.logo_url && (
      <img src={site.logo_url} alt="" class="w-10 h-10 rounded-md object-cover object-left bg-white border border-slate-100 shrink-0" loading="lazy" />
    )}
    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-2">
        <h3 class="font-semibold text-slate-900 truncate">{site.name}</h3>
        <div class="flex shrink-0 items-center gap-1.5">
          {showCategory && (
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500">
              {site.category_name}
            </span>
          )}
          <button
            type="button"
            data-bookmark-toggle
            data-site-id={site.id}
            class="rounded p-0.5 text-slate-300 hover:text-amber-500"
            aria-label="즐겨찾기"
          >
            <span data-bookmark-icon>☆</span>
          </button>
        </div>
      </div>
      <p class="mt-1 text-sm text-slate-500 line-clamp-2">{site.tagline || site.description}</p>
      <div class="mt-3 flex items-center gap-2 text-xs text-slate-400">
        <span class="truncate">{new URL(site.url).hostname}</span>
        {site.platform && <span class="shrink-0 rounded-full bg-slate-900 text-white px-2 py-0.5">{site.platform}</span>}
        {site.site_type && <span class="shrink-0 rounded-full border border-slate-200 px-2 py-0.5">{site.site_type}</span>}
        {site.region && <span class="shrink-0 rounded-full border border-slate-200 px-2 py-0.5">{site.region}</span>}
      </div>
    </div>
  </div>
</a>
