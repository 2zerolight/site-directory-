---
interface Props {
  index: number;
  title: string;
  description?: string;
}

const { index, title, description } = Astro.props;
---

<section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
  <div class="flex items-start gap-3">
    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-900 text-xs font-semibold text-white">
      {index}
    </span>
    <div>
      <h2 class="text-base font-semibold text-slate-900">{title}</h2>
      {description && <p class="mt-0.5 text-sm text-slate-500">{description}</p>}
    </div>
  </div>
  <div class="mt-6 space-y-5">
    <slot />
  </div>
</section>
