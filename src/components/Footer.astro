---
import { env } from 'cloudflare:workers';
import { getCategories } from '../lib/db';
import { SITE_NAME, CONTACT_EMAIL } from '../lib/site';

const categories = await getCategories(env.DB);

const serviceLinks = [
  { href: '/about', label: '서비스 소개' },
  { href: '/submit', label: '사이트 등록' },
  { href: '/search', label: '검색' },
  { href: '/faq', label: '자주 묻는 질문' },
  { href: '/updates', label: '업데이트' },
];
---

<footer class="border-t border-slate-200 bg-white mt-12">
  <div class="max-w-6xl mx-auto px-4 py-10">
    <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-7 gap-3 text-sm">
      {categories.map((category) => (
        <a href={`/category/${category.slug}`} class="text-slate-600 hover:text-slate-900 hover:underline">
          {category.name}
        </a>
      ))}
    </div>

    <div class="mt-8 border-t border-slate-100 pt-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <nav class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
        {serviceLinks.map((link) => (
          <a href={link.href} class="text-slate-500 hover:text-slate-900 hover:underline">{link.label}</a>
        ))}
      </nav>

      <nav class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
        {/* 개인정보처리방침은 법적 고지이자 광고 심사에서 가장 먼저 찾는 링크라 강조해둔다. */}
        <a href="/privacy" class="font-medium text-slate-700 hover:text-slate-900 hover:underline">개인정보처리방침</a>
        <a href="/terms" class="text-slate-500 hover:text-slate-900 hover:underline">이용약관</a>
        <a href="/contact" class="text-slate-500 hover:text-slate-900 hover:underline">문의</a>
      </nav>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-400">
      <p>&copy; {new Date().getFullYear()} {SITE_NAME}. All sites listed belong to their respective owners.</p>
      <a href={`mailto:${CONTACT_EMAIL}`} class="hover:text-slate-600">{CONTACT_EMAIL}</a>
    </div>
  </div>
</footer>
