---
import type { Category, Subcategory, SiteWithCategory } from '../types';
import { REGIONS, SITE_TYPES, PLATFORMS } from '../lib/constants';

interface Props {
  site: SiteWithCategory;
  categories: Category[];
  subcategories: Subcategory[];
  redirectTo: string;
}

const { site, categories, subcategories, redirectTo } = Astro.props;

const textFields = [
  ['name', '사이트 이름', site.name, 'text'],
  ['url', '사이트 URL', site.url, 'url'],
  ['tagline', '한 줄 소개', site.tagline, 'text'],
  ['logoUrl', '로고 이미지 URL', site.logo_url, 'url'],
  ['coverImageUrl', '대표 이미지 URL', site.cover_image_url, 'url'],
  ['mainKeywords', '주요 키워드', site.main_keywords, 'text'],
  ['serviceKeywords', '서비스 키워드', site.service_keywords, 'text'],
  ['operatorName', '운영 주체', site.operator_name, 'text'],
  ['businessName', '사업자명', site.business_name, 'text'],
  ['serviceRegion', '서비스 지역', site.service_region, 'text'],
  ['customerCenter', '고객센터', site.customer_center, 'text'],
  ['contactEmail', '공개 이메일', site.contact_email, 'email'],
  ['blogUrl', '블로그', site.blog_url, 'url'],
  ['youtubeUrl', '유튜브', site.youtube_url, 'url'],
  ['instagramUrl', '인스타그램', site.instagram_url, 'url'],
  ['facebookUrl', '페이스북', site.facebook_url, 'url'],
  ['otherSnsUrl', '기타 SNS', site.other_sns_url, 'url'],
] as [string, string, string | null, 'text' | 'url' | 'email'][];

const adminInputClass =
  'mt-1 w-full rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900';
const adminLabelClass = 'text-xs font-medium text-slate-500';

const statusLabel = { pending: '대기', approved: '승인됨', rejected: '거절됨' }[site.status];
const statusBadgeClass = {
  pending: 'bg-amber-100 text-amber-700',
  approved: 'bg-green-100 text-green-700',
  rejected: 'bg-red-100 text-red-700',
}[site.status];
---

<li id={`site-${site.id}`} class="scroll-mt-4 rounded-lg border border-slate-200 bg-white p-4">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="font-semibold text-slate-900">
        {site.name}
        <span class="ml-2 text-xs text-slate-400">
          {site.category_name}{site.subcategory_name ? ` · ${site.subcategory_name}` : ''}
          {site.platform ? ` · ${site.platform}` : ''}
          {site.region ? ` · ${site.region}` : ''}
          {site.site_type ? ` · ${site.site_type}` : ''}
        </span>
        <span class={`ml-2 rounded-full px-2 py-0.5 text-xs ${statusBadgeClass}`}>{statusLabel}</span>
        {site.ownership_verified ? (
          <span class="ml-2 rounded-full bg-green-100 px-2 py-0.5 text-xs text-green-700">
            {site.verified_by_admin ? '관리자 인증됨' : '소유권 인증됨'}
          </span>
        ) : site.third_party_submission ? (
          <span class="ml-2 rounded-full bg-blue-100 px-2 py-0.5 text-xs text-blue-700">제3자 제출 · 검토 필요</span>
        ) : (
          <span class="ml-2 rounded-full bg-amber-100 px-2 py-0.5 text-xs text-amber-700">미인증</span>
        )}
      </p>
      <a href={site.url} target="_blank" rel="noopener noreferrer" class="text-sm text-slate-500 underline">{site.url}</a>
      {site.status === 'approved' && (
        <a href={`/site/${site.slug}`} class="ml-2 text-sm text-slate-400 underline hover:text-slate-600">공개 페이지 보기</a>
      )}
      <p class="mt-1 text-sm text-slate-600">{site.tagline}</p>
      <p class="mt-1 text-xs text-slate-400 whitespace-pre-line break-words">{site.description}</p>
      {site.submitted_email && <p class="mt-1 text-xs text-slate-400">제출자: {site.submitted_email}</p>}
    </div>
    <div class="flex gap-2 shrink-0">
      {site.status !== 'approved' && (
        <form method="post">
          <input type="hidden" name="action" value="approve" />
          <input type="hidden" name="id" value={site.id} />
          <input type="hidden" name="url" value={site.url} />
          <input type="hidden" name="redirectTo" value={redirectTo} />
          <button type="submit" class="rounded-md bg-green-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-green-500">승인</button>
        </form>
      )}
      {site.status !== 'rejected' && (
        <form method="post">
          <input type="hidden" name="action" value="reject" />
          <input type="hidden" name="id" value={site.id} />
          <input type="hidden" name="redirectTo" value={redirectTo} />
          <button type="submit" class="rounded-md bg-red-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-red-500">거절</button>
        </form>
      )}
      {site.status !== 'pending' && (
        <form method="post">
          <input type="hidden" name="action" value="set_pending" />
          <input type="hidden" name="id" value={site.id} />
          <input type="hidden" name="redirectTo" value={redirectTo} />
          <button type="submit" class="rounded-md border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50">대기로 전환</button>
        </form>
      )}
    </div>
  </div>

  <details class="mt-3">
    <summary class="cursor-pointer text-xs font-medium text-slate-500 underline">상세 정보 · 수정</summary>

    <div class="mt-3 rounded-md border border-slate-100 bg-slate-50 p-4">
      {!site.ownership_verified && (
        <form method="post" class="mb-4">
          <input type="hidden" name="action" value="verify_admin" />
          <input type="hidden" name="id" value={site.id} />
          <input type="hidden" name="redirectTo" value={redirectTo} />
          <button type="submit" class="rounded-md bg-blue-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-blue-500">
            관리자 재량으로 소유권 인증 처리
          </button>
        </form>
      )}

      <form method="post" class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <input type="hidden" name="action" value="update" />
        <input type="hidden" name="id" value={site.id} />
        <input type="hidden" name="redirectTo" value={redirectTo} />

        {textFields.map(([formName, label, value, type]) => (
          <div>
            <label class={adminLabelClass} for={`${formName}-${site.id}`}>{label}</label>
            <input
              id={`${formName}-${site.id}`}
              name={formName}
              type={type === 'url' ? 'text' : type}
              inputmode={type === 'url' ? 'url' : undefined}
              value={value ?? ''}
              class={adminInputClass}
            />
          </div>
        ))}

        <div class="sm:col-span-2">
          <label class={adminLabelClass} for={`description-${site.id}`}>상세 설명</label>
          <textarea id={`description-${site.id}`} name="description" rows="3" class={adminInputClass}>{site.description}</textarea>
        </div>

        <div>
          <label class={adminLabelClass} for={`categoryId-${site.id}`}>대분류</label>
          <select id={`categoryId-${site.id}`} name="categoryId" class={adminInputClass}>
            {categories.map((c: Category) => (
              <option value={c.id} selected={c.id === site.category_id}>{c.name}</option>
            ))}
          </select>
        </div>
        <div>
          <label class={adminLabelClass} for={`subcategoryId-${site.id}`}>중분류</label>
          <select id={`subcategoryId-${site.id}`} name="subcategoryId" class={adminInputClass}>
            <option value="">선택 안 함</option>
            {subcategories
              .filter((s) => s.category_id === site.category_id)
              .map((sub) => (
                <option value={sub.id} selected={sub.id === site.subcategory_id}>{sub.name}</option>
              ))}
          </select>
        </div>

        <div>
          <label class={adminLabelClass} for={`region-${site.id}`}>지역</label>
          <select id={`region-${site.id}`} name="region" class={adminInputClass}>
            <option value="">선택 안 함</option>
            {REGIONS.map((r) => <option value={r} selected={r === site.region}>{r}</option>)}
          </select>
        </div>
        <div>
          <label class={adminLabelClass} for={`siteType-${site.id}`}>사이트 유형</label>
          <select id={`siteType-${site.id}`} name="siteType" class={adminInputClass}>
            <option value="">선택 안 함</option>
            {SITE_TYPES.map((t) => <option value={t} selected={t === site.site_type}>{t}</option>)}
          </select>
        </div>
        <div>
          <label class={adminLabelClass} for={`platform-${site.id}`}>플랫폼</label>
          <select id={`platform-${site.id}`} name="platform" class={adminInputClass}>
            <option value="">선택 안 함</option>
            {PLATFORMS.map((p) => <option value={p} selected={p === site.platform}>{p}</option>)}
          </select>
        </div>

        <div class="sm:col-span-2 flex justify-end">
          <button type="submit" class="rounded-md bg-slate-900 px-4 py-1.5 text-xs font-medium text-white hover:bg-slate-700">
            저장
          </button>
        </div>
      </form>
    </div>
  </details>
</li>
