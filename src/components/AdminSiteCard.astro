---
import { env } from 'cloudflare:workers';
import type { Category, Subcategory, SiteWithCategory } from '../types';
import { REGIONS, SITE_TYPES, PLATFORMS } from '../lib/constants';
import { SITE_URL } from '../lib/site';
import { getTagsForSite } from '../lib/db';

interface Props {
  site: SiteWithCategory;
  categories: Category[];
  subcategories: Subcategory[];
  redirectTo: string;
}

const { site, categories, subcategories, redirectTo } = Astro.props;
const tags = await getTagsForSite(env.DB, site.id);
const tagsValue = tags.map((t) => t.name).join(', ');

const textFields = [
  ['name', '사이트 이름', site.name, 'text'],
  ['url', '사이트 URL', site.url, 'url'],
  ['tagline', '한 줄 소개', site.tagline, 'text'],
  ['logoUrl', '로고 이미지 URL', site.logo_url, 'url'],
  ['coverImageUrl', '대표 이미지 URL', site.cover_image_url, 'url'],
  ['mainKeywords', '주요 키워드', site.main_keywords, 'text'],
  ['serviceKeywords', '서비스 키워드', site.service_keywords, 'text'],
  ['operatorName', '운영 주체', site.operator_name, 'text'],
  ['businessName', '사업자명', site.business_name, 'text'],
  ['serviceRegion', '서비스 지역', site.service_region, 'text'],
  ['customerCenter', '고객센터', site.customer_center, 'text'],
  ['contactEmail', '공개 이메일', site.contact_email, 'email'],
  ['blogUrl', '블로그', site.blog_url, 'url'],
  ['youtubeUrl', '유튜브', site.youtube_url, 'url'],
  ['instagramUrl', '인스타그램', site.instagram_url, 'url'],
  ['facebookUrl', '페이스북', site.facebook_url, 'url'],
  ['otherSnsUrl', '기타 SNS', site.other_sns_url, 'url'],
] as [string, string, string | null, 'text' | 'url' | 'email'][];

const adminInputClass =
  'mt-1 w-full rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-xs text-slate-900 focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900';
const adminLabelClass = 'text-xs font-medium text-slate-500';

const statusLabel = { pending: '대기', approved: '승인됨', rejected: '거절됨' }[site.status];
const statusBadgeClass = {
  pending: 'bg-amber-100 text-amber-700',
  approved: 'bg-green-100 text-green-700',
  rejected: 'bg-red-100 text-red-700',
}[site.status];
---

<li id={`site-${site.id}`} class="scroll-mt-4 rounded-lg border border-slate-200 bg-white p-4">
  <div class="flex flex-nowrap items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="font-semibold text-slate-900">
        <input type="checkbox" name="ids" value={site.id} form="bulk-form" class="mr-1.5 align-middle" aria-label={`${site.name} 선택`} />
        {site.name}
        <span class="ml-2 text-xs text-slate-400">
          {site.category_name}{site.subcategory_name ? ` · ${site.subcategory_name}` : ''}
          {site.platform ? ` · ${site.platform}` : ''}
          {site.region ? ` · ${site.region}` : ''}
          {site.site_type ? ` · ${site.site_type}` : ''}
        </span>
        <span class={`ml-2 rounded-full px-2 py-0.5 text-xs ${statusBadgeClass}`}>{statusLabel}</span>
        {site.ownership_verified ? (
          <span class="ml-2 rounded-full bg-green-100 px-2 py-0.5 text-xs text-green-700">
            {site.verified_by_admin ? '관리자 인증됨' : '소유권 인증됨'}
          </span>
        ) : site.third_party_submission ? (
          <span class="ml-2 rounded-full bg-blue-100 px-2 py-0.5 text-xs text-blue-700">제3자 제출 · 검토 필요</span>
        ) : (
          <span class="ml-2 rounded-full bg-amber-100 px-2 py-0.5 text-xs text-amber-700">미인증</span>
        )}
      </p>
      <a href={site.url} target="_blank" rel="noopener noreferrer" class="text-sm text-slate-500 underline">{site.url}</a>
      <a href={`/site/${site.slug}`} class="ml-2 text-sm text-slate-400 underline hover:text-slate-600">
        {site.status === 'approved' ? '공개 페이지 보기' : '미리보기'}
      </a>
      <p class="mt-1 text-sm text-slate-600">{site.tagline}</p>
      <p class="mt-1 text-xs text-slate-400 whitespace-pre-line break-words">{site.description}</p>
      {site.submitted_email && <p class="mt-1 text-xs text-slate-400">제출자: {site.submitted_email}</p>}
    </div>
    <div class="flex gap-2 shrink-0">
      {/*
        제출자에게 보낼 메일 문안(승인·거절·보완 요청 등)을 만드는 화면. 발송은
        관리자가 지메일에서 직접 한다.
      */}
      <a
        href={`/dashboard/email/${site.id}`}
        class="rounded-md border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50"
      >
        메일 작성
      </a>
      {site.status !== 'approved' && (
        <form method="post">
          <input type="hidden" name="action" value="approve" />
          <input type="hidden" name="id" value={site.id} />
          <input type="hidden" name="url" value={site.url} />
          <input type="hidden" name="redirectTo" value={redirectTo} />
          <button type="submit" class="rounded-md bg-green-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-green-500">승인</button>
        </form>
      )}
      {site.status !== 'rejected' && (
        <form method="post">
          <input type="hidden" name="action" value="reject" />
          <input type="hidden" name="id" value={site.id} />
          <input type="hidden" name="redirectTo" value={redirectTo} />
          <button type="submit" class="rounded-md bg-red-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-red-500">거절</button>
        </form>
      )}
      {site.status !== 'pending' && (
        <form method="post">
          <input type="hidden" name="action" value="set_pending" />
          <input type="hidden" name="id" value={site.id} />
          <input type="hidden" name="redirectTo" value={redirectTo} />
          <button type="submit" class="rounded-md border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50">대기로 전환</button>
        </form>
      )}
    </div>
  </div>

  <details class="mt-3">
    <summary class="cursor-pointer text-xs font-medium text-slate-500 underline">상세 정보 · 수정</summary>

    <div class="mt-3 rounded-md border border-slate-100 bg-slate-50 p-4">
      {!site.ownership_verified && (
        <div class="mb-4 space-y-3">
          <form method="post">
            <input type="hidden" name="action" value="verify_admin" />
            <input type="hidden" name="id" value={site.id} />
            <input type="hidden" name="redirectTo" value={redirectTo} />
            <button type="submit" class="rounded-md bg-blue-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-blue-500">
              관리자 재량으로 소유권 인증 처리
            </button>
          </form>

          {site.verification_secret && (
            <div>
              {/*
                운영자에게 건네주는 셀프 인증 링크. 이 주소를 아는 사람만 그 사이트의
                인증 페이지를 열 수 있으므로, 아무한테나 뿌리면 안 된다.
              */}
              <p class="text-xs font-medium text-slate-500">운영자에게 보낼 인증 링크</p>
              <input
                type="text"
                readonly
                value={`${SITE_URL}/submit/verify/${site.verification_secret}`}
                onclick="this.select()"
                class="mt-1 w-full rounded-md border border-slate-200 bg-white px-2 py-1.5 font-mono text-xs text-slate-600"
              />
              <p class="mt-1 text-xs text-slate-400">
                클릭하면 전체 선택됩니다. 해당 사이트 운영자에게만 전달하세요.
                <a href={`/dashboard/email/${site.id}?type=verify_link`} class="underline hover:text-slate-600">안내 메일 문안</a>
              </p>
            </div>
          )}
        </div>
      )}

      <form method="post" enctype="multipart/form-data" class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <input type="hidden" name="action" value="update" />
        <input type="hidden" name="id" value={site.id} />
        <input type="hidden" name="redirectTo" value={redirectTo} />

        {textFields.map(([formName, label, value, type]) => (
          <div>
            <label class={adminLabelClass} for={`${formName}-${site.id}`}>{label}</label>
            <input
              id={`${formName}-${site.id}`}
              name={formName}
              type={type === 'url' ? 'text' : type}
              inputmode={type === 'url' ? 'url' : undefined}
              value={value ?? ''}
              class={adminInputClass}
            />
            {formName === 'logoUrl' && (
              <div class="mt-2 rounded-md border border-dashed border-slate-200 bg-white p-2.5" data-favicon-root data-site-id={site.id}>
                <div class="flex flex-wrap items-center gap-2">
                  <button
                    type="button"
                    data-favicon-load
                    class="rounded-md border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-600 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50"
                  >
                    파비콘 불러오기
                  </button>
                  <span data-favicon-status class="text-xs text-slate-400">사이트 URL 의 아이콘을 가져와 고를 수 있습니다.</span>
                </div>
                <div data-favicon-list class="mt-2 flex flex-wrap gap-2 empty:hidden"></div>
              </div>
            )}
            {formName === 'logoUrl' && (
              <div class="mt-2 flex items-start gap-3">
                {site.logo_url && (
                  <img src={site.logo_url} alt="현재 로고" class="h-10 w-10 shrink-0 rounded-md border border-slate-200 bg-white object-contain" />
                )}
                <div class="min-w-0">
                  <label class={adminLabelClass} for={`logoFile-${site.id}`}>또는 파일로 올리기</label>
                  <input
                    id={`logoFile-${site.id}`}
                    name="logoFile"
                    type="file"
                    accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml"
                    class="mt-1 block w-full text-xs text-slate-600 file:mr-2 file:rounded-md file:border file:border-slate-300 file:bg-white file:px-2.5 file:py-1 file:text-xs file:font-medium file:text-slate-600"
                  />
                  <p class="mt-1 text-xs text-slate-400">
                    이미지 주소가 외부 노출을 막는 사이트용입니다. PNG·JPG·GIF·WebP·SVG, 200KB 이하.
                    파일을 고르면 위 주소 칸보다 우선하며, 저장하면 주소가 자동으로 바뀝니다.
                    주소 칸을 직접 바꾸거나 비우면 올려둔 파일은 지워집니다.
                  </p>
                </div>
              </div>
            )}
          </div>
        ))}

        <div class="sm:col-span-2">
          <label class={adminLabelClass} for={`description-${site.id}`}>상세 설명</label>
          <textarea id={`description-${site.id}`} name="description" rows="3" class={adminInputClass}>{site.description}</textarea>
        </div>

        <div class="sm:col-span-2">
          <label class={adminLabelClass} for={`tags-${site.id}`}>태그 (쉼표로 구분)</label>
          <input id={`tags-${site.id}`} name="tags" type="text" value={tagsValue} class={adminInputClass} placeholder="예: 무료, 회원가입 불필요, 모바일 앱" />
        </div>

        <div>
          <label class={adminLabelClass} for={`categoryId-${site.id}`}>대분류</label>
          <select id={`categoryId-${site.id}`} name="categoryId" class={adminInputClass}>
            {categories.map((c: Category) => (
              <option value={c.id} selected={c.id === site.category_id}>{c.name}</option>
            ))}
          </select>
        </div>
        <div>
          <label class={adminLabelClass} for={`subcategoryId-${site.id}`}>중분류</label>
          <select id={`subcategoryId-${site.id}`} name="subcategoryId" class={adminInputClass}>
            <option value="">선택 안 함</option>
            {subcategories
              .filter((s) => s.category_id === site.category_id)
              .map((sub) => (
                <option value={sub.id} selected={sub.id === site.subcategory_id}>{sub.name}</option>
              ))}
          </select>
        </div>

        <div>
          <label class={adminLabelClass} for={`region-${site.id}`}>지역</label>
          <select id={`region-${site.id}`} name="region" class={adminInputClass}>
            <option value="">선택 안 함</option>
            {REGIONS.map((r) => <option value={r} selected={r === site.region}>{r}</option>)}
          </select>
        </div>
        <div>
          <label class={adminLabelClass} for={`siteType-${site.id}`}>사이트 유형</label>
          <select id={`siteType-${site.id}`} name="siteType" class={adminInputClass}>
            <option value="">선택 안 함</option>
            {SITE_TYPES.map((t) => <option value={t} selected={t === site.site_type}>{t}</option>)}
          </select>
        </div>
        <div>
          <label class={adminLabelClass} for={`platform-${site.id}`}>플랫폼</label>
          <select id={`platform-${site.id}`} name="platform" class={adminInputClass}>
            <option value="">선택 안 함</option>
            {PLATFORMS.map((p) => <option value={p} selected={p === site.platform}>{p}</option>)}
          </select>
        </div>

        <div class="sm:col-span-2 flex justify-end">
          <button type="submit" class="rounded-md bg-slate-900 px-4 py-1.5 text-xs font-medium text-white hover:bg-slate-700">
            저장
          </button>
        </div>
      </form>
    </div>

    <div class="mt-4 rounded-md border border-red-200 bg-red-50/40 p-4">
      <h4 class="text-xs font-semibold text-red-700">영구 삭제</h4>
      <p class="mt-1 text-xs text-slate-500">
        거절은 목록에서 감추기만 하고 되돌릴 수 있지만, 삭제는 되돌릴 수 없습니다.
        태그 연결과 리뷰도 함께 지워집니다. 삭제하려면 사이트 이름
        <span class="font-mono text-slate-700">{site.name}</span> 을 그대로 입력하세요.
      </p>
      <form method="post" class="mt-2 flex flex-wrap items-center gap-2">
        <input type="hidden" name="action" value="delete" />
        <input type="hidden" name="id" value={site.id} />
        <input type="hidden" name="redirectTo" value={redirectTo} />
        <input
          type="text"
          name="confirmName"
          required
          autocomplete="off"
          placeholder={site.name}
          class="w-56 rounded-md border border-slate-300 bg-white px-2 py-1.5 text-xs"
        />
        <button type="submit" class="rounded-md bg-red-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-red-500">
          영구 삭제
        </button>
      </form>
    </div>
  </details>
</li>

<script>
  /*
    로고 URL 칸 아래에 사이트 파비콘 후보를 보여주고, 누르면 그 주소를 칸에 넣는다.

    카드가 수백 개라 페이지가 열릴 때 전부 부르면 API 호출 한도(분당 60회)를 넘는다. 그래서
    "상세 정보 · 수정"을 처음 열 때(또는 버튼을 눌렀을 때) 그 카드 하나만 부른다. 같은
    도메인은 서버가 하루 동안 캐시하므로 다시 열어도 제공처를 부르지 않는다.
  */
  type Icon = { url: string; width: number | null; height: number | null; vector: boolean };
  type Result = { ok: true; icons: Icon[]; cached: boolean } | { ok: false; reason: string };

  const FAIL_MESSAGES: Record<string, string> = {
    disabled: '파비콘 API 키(FAVICON_API_KEY)가 설정되지 않았습니다.',
    unauthorized: '파비콘 API 키가 올바르지 않습니다.',
    rate_limited: '호출 한도에 걸렸습니다. 잠시 뒤에 다시 시도하세요.',
    busy: '파비콘 서비스가 바쁩니다. 잠시 뒤에 다시 시도하세요.',
    blocked: '이 주소는 조회할 수 없습니다.',
    invalid: '조회할 수 있는 사이트 URL 이 아닙니다.',
    unauthorized_admin: '관리자 로그인이 필요합니다.',
    timeout: '응답이 늦어 불러오지 못했습니다.',
  };

  const ACTIVE = ['border-slate-900', 'ring-2', 'ring-slate-900', 'bg-slate-50'];
  const IDLE = ['border-slate-200', 'bg-white'];

  function sizeLabel(icon: Icon): string {
    if (icon.vector) return 'SVG';
    if (icon.width && icon.height) return `${icon.width}×${icon.height}`;
    return '크기 미확인';
  }

  function syncActive(root: HTMLElement) {
    const input = document.getElementById(`logoUrl-${root.dataset.siteId}`) as HTMLInputElement | null;
    const current = input?.value.trim() ?? '';
    root.querySelectorAll<HTMLButtonElement>('[data-favicon-url]').forEach((button) => {
      const active = current !== '' && button.dataset.faviconUrl === current;
      button.setAttribute('aria-pressed', String(active));
      button.classList.remove(...(active ? IDLE : ACTIVE));
      button.classList.add(...(active ? ACTIVE : IDLE));
    });
  }

  function render(root: HTMLElement, icons: Icon[]) {
    const list = root.querySelector<HTMLElement>('[data-favicon-list]');
    const input = document.getElementById(`logoUrl-${root.dataset.siteId}`) as HTMLInputElement | null;
    if (!list || !input) return;
    list.replaceChildren();

    for (const icon of icons) {
      const button = document.createElement('button');
      button.type = 'button';
      button.dataset.faviconUrl = icon.url;
      button.title = icon.url;
      button.className = 'flex w-16 flex-col items-center gap-1 rounded-md border p-1.5 text-center transition hover:border-slate-400';

      const frame = document.createElement('span');
      frame.className = 'flex h-10 w-10 items-center justify-center overflow-hidden rounded bg-white';
      const img = document.createElement('img');
      img.src = icon.url;
      img.alt = '';
      img.loading = 'lazy';
      img.referrerPolicy = 'no-referrer';
      img.className = 'max-h-10 max-w-10 object-contain';
      // 핫링크를 막는 사이트라면 미리보기가 깨진다. 선택은 여전히 할 수 있다.
      img.addEventListener('error', () => {
        frame.textContent = '표시 불가';
        frame.className = 'flex h-10 w-10 items-center justify-center rounded bg-slate-100 text-[9px] leading-tight text-slate-400';
      });
      frame.appendChild(img);

      const label = document.createElement('span');
      label.className = 'text-[10px] leading-none text-slate-500';
      label.textContent = sizeLabel(icon);

      button.appendChild(frame);
      button.appendChild(label);
      button.addEventListener('click', () => {
        input.value = icon.url;
        input.dispatchEvent(new Event('input', { bubbles: true }));
        syncActive(root);
      });
      list.appendChild(button);
    }

    // 주소를 직접 고치거나 지우면 선택 표시도 따라가게 한다. 카드마다 한 번만 건다.
    if (!input.dataset.faviconBound) {
      input.dataset.faviconBound = '1';
      input.addEventListener('input', () => syncActive(root));
    }
    syncActive(root);
  }

  async function load(root: HTMLElement) {
    if (root.dataset.loading === '1') return;
    const siteId = root.dataset.siteId;
    const urlInput = document.getElementById(`url-${siteId}`) as HTMLInputElement | null;
    const status = root.querySelector<HTMLElement>('[data-favicon-status]');
    const button = root.querySelector<HTMLButtonElement>('[data-favicon-load]');
    const target = urlInput?.value.trim() ?? '';
    if (!status || !target) return;

    root.dataset.loading = '1';
    if (button) button.disabled = true;
    status.textContent = '아이콘을 불러오는 중…';
    try {
      const res = await fetch(`/api/favicon?url=${encodeURIComponent(target)}`, { credentials: 'same-origin' });
      const data = (await res.json()) as Result;
      if (!data.ok) {
        status.textContent = FAIL_MESSAGES[data.reason] ?? '아이콘을 불러오지 못했습니다.';
        root.querySelector('[data-favicon-list]')?.replaceChildren();
      } else if (data.icons.length === 0) {
        status.textContent = '이 사이트에서 아이콘을 찾지 못했습니다. 직접 올리거나 주소를 입력하세요.';
        root.querySelector('[data-favicon-list]')?.replaceChildren();
      } else {
        status.textContent = `아이콘 ${data.icons.length}개 · 작은 순서 · 눌러서 선택${data.cached ? ' · 캐시된 결과' : ''}`;
        render(root, data.icons);
      }
      root.dataset.loaded = '1';
    } catch {
      status.textContent = '아이콘을 불러오지 못했습니다.';
    } finally {
      root.dataset.loading = '';
      if (button) button.disabled = false;
    }
  }

  // toggle 이벤트는 버블링하지 않아 캡처 단계에서 받는다.
  document.addEventListener(
    'toggle',
    (event) => {
      const target = event.target;
      if (!(target instanceof HTMLDetailsElement) || !target.open) return;
      const root = target.querySelector<HTMLElement>('[data-favicon-root]');
      if (root && !root.dataset.loaded) void load(root);
    },
    true
  );

  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-favicon-load]');
    const root = button?.closest<HTMLElement>('[data-favicon-root]');
    if (root) void load(root);
  });
</script>
