---
import { SITE_NAME } from '../lib/site';

const q = Astro.url.searchParams.get('q') ?? '';
---

<header class="border-b border-slate-200 bg-white">
  <div class="max-w-6xl mx-auto px-4 py-4 flex flex-wrap items-center gap-4 justify-between">
    <a href="/" class="text-lg font-bold tracking-tight text-slate-900">
      {SITE_NAME}
    </a>

    <form action="/search" method="get" class="flex-1 min-w-[200px] max-w-md">
      <label class="sr-only" for="header-search">사이트 검색</label>
      <input
        id="header-search"
        type="search"
        name="q"
        value={q}
        placeholder="사이트 이름이나 설명으로 검색"
        class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
      />
    </form>

    <a
      href="/submit"
      class="shrink-0 rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700"
    >
      사이트 등록
    </a>
  </div>
</header>
