---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { SITE_NAME, SITE_URL, GA_MEASUREMENT_ID, ADSENSE_CLIENT_ID } from '../lib/site';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  image?: string;
}

const { title, description, canonicalPath, jsonLd, noindex = false, image } = Astro.props;
const canonicalUrl = new URL(canonicalPath, SITE_URL).toString();
// 이미 사이트명으로 시작하는 제목(홈의 "사이트다 – 국내 웹사이트 디렉토리" 등)에는
// 사이트명을 또 붙이지 않는다.
const fullTitle = title.startsWith(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const ogImageUrl = new URL(image || '/og-image.png', SITE_URL).toString();
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />
    ))}

    {/*
      Google Analytics 는 이용자가 동의하기 전까지 로드하지 않는다. 여기서는 Consent Mode 의
      기본값을 전부 denied 로 선언하고 config 호출만 dataLayer 에 쌓아둔다. 동의가 들어오면
      sitedaGrantConsent() 가 gtag.js 를 주입하고, 큐에 쌓여 있던 호출이 그때 처리된다.
      동의 전에는 Google 로 나가는 요청 자체가 없다. (CookieConsent.astro 와 한 쌍)
    */}
    <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
      });

      gtag('js', new Date());
      gtag('config', GA_MEASUREMENT_ID);

      window.sitedaGrantConsent = function () {
        if (window.sitedaConsentGranted) return;
        window.sitedaConsentGranted = true;

        gtag('consent', 'update', {
          ad_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
          analytics_storage: 'granted',
        });

        const tag = document.createElement('script');
        tag.async = true;
        tag.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
        document.head.appendChild(tag);
      };

      // 동의 철회. Consent Mode 를 denied 로 되돌리는 것만으로는 부족하다 —
      // 동의했던 동안 이미 심어진 _ga 쿠키가 그대로 남아 이용자를 계속 식별한다.
      // 철회의 의미가 있으려면 그 쿠키까지 지워야 한다.
      window.sitedaRevokeConsent = function () {
        window.sitedaConsentGranted = false;

        gtag('consent', 'update', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
        });

        const names = document.cookie
          .split(';')
          .map((c) => c.split('=')[0].trim())
          .filter((name) => /^(_ga|_gid|_gat)/.test(name));

        // 쿠키는 설정된 domain 이 정확히 일치해야 지워진다. GA 가 어느 레벨에
        // 심었는지 알 수 없으므로 호스트명의 모든 상위 도메인에 대해 시도한다.
        const parts = location.hostname.split('.');
        const domains = [null];
        for (let i = 0; i < parts.length - 1; i++) {
          domains.push('.' + parts.slice(i).join('.'));
        }

        names.forEach((name) => {
          domains.forEach((domain) => {
            document.cookie = name + '=; Max-Age=0; path=/' + (domain ? '; domain=' + domain : '');
          });
        });
      };
    </script>

    {/*
      AdSense 는 GA 와 달리 동의 전에도 스크립트를 로드한다. 이유가 둘 있다.

      하나, 심사가 진행되려면 코드가 실제로 실행돼야 한다. 동의 전에 막아두면
      심사자와 크롤러에게는 코드가 없는 사이트로 보인다.

      둘, 위 Consent Mode 기본값이 ad_storage/ad_user_data/ad_personalization 을
      전부 denied 로 선언해뒀기 때문에, 동의 전에는 쿠키 없이 비맞춤형 광고만
      나간다. 광고를 아예 막는 것과 달리 이쪽은 수익을 유지하면서도 동의 전
      추적을 하지 않는다 — Google 이 CMP 연동에 권장하는 방식이다.

      noindex 페이지에는 넣지 않는다. 404·검색결과·관리자 화면처럼 게시자 콘텐츠가
      없는 페이지에 광고를 붙이는 것은 AdSense 정책 위반이다.
    */}
    {!noindex && (
      <script
        async
        is:inline
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT_ID}`}
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-900">
    <Header />
    <main class="flex-1 w-full max-w-6xl mx-auto px-4 py-8">
      <slot />
    </main>
    <Footer />
    <CookieConsent />

    <script>
      const BOOKMARK_KEY = 'siteda_bookmarks';

      function getBookmarks(): number[] {
        try {
          const raw = localStorage.getItem(BOOKMARK_KEY);
          return raw ? (JSON.parse(raw) as number[]) : [];
        } catch {
          return [];
        }
      }

      function setBookmarks(ids: number[]) {
        localStorage.setItem(BOOKMARK_KEY, JSON.stringify(ids));
      }

      function syncIcon(el: HTMLElement, bookmarked: boolean) {
        const icon = el.querySelector('[data-bookmark-icon]');
        if (icon) icon.textContent = bookmarked ? '★' : '☆';
        el.classList.toggle('text-amber-500', bookmarked);
        el.setAttribute('aria-pressed', String(bookmarked));
      }

      function initBookmarkButtons() {
        const bookmarks = getBookmarks();
        document.querySelectorAll<HTMLElement>('[data-bookmark-toggle]').forEach((el) => {
          const id = Number(el.dataset.siteId);
          syncIcon(el, bookmarks.includes(id));
          if (el.dataset.bookmarkBound) return;
          el.dataset.bookmarkBound = '1';
          el.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const current = getBookmarks();
            const idx = current.indexOf(id);
            const nowBookmarked = idx === -1;
            if (nowBookmarked) current.push(id);
            else current.splice(idx, 1);
            setBookmarks(current);
            syncIcon(el, nowBookmarked);
          });
        });
      }

      initBookmarkButtons();
      document.addEventListener('astro:page-load', initBookmarkButtons);

      function initShareButtons() {
        document.querySelectorAll<HTMLElement>('[data-share-button]').forEach((el) => {
          if (el.dataset.shareBound) return;
          el.dataset.shareBound = '1';
          el.addEventListener('click', async (e) => {
            e.preventDefault();
            e.stopPropagation();
            const url = el.dataset.shareUrl || location.href;
            const title = el.dataset.shareTitle || document.title;
            const text = el.dataset.shareText || '';
            const label = el.querySelector('[data-share-label]');

            if (navigator.share) {
              try {
                await navigator.share({ title, text, url });
              } catch {
                // user cancelled or share failed silently
              }
              return;
            }

            try {
              await navigator.clipboard.writeText(url);
              if (label) {
                const original = label.textContent;
                label.textContent = '복사됨!';
                setTimeout(() => {
                  label.textContent = original;
                }, 1500);
              }
            } catch {
              // clipboard unavailable; nothing more we can do
            }
          });
        });
      }

      initShareButtons();
      document.addEventListener('astro:page-load', initShareButtons);

      const HELPFUL_KEY = 'siteda_helpful_votes';

      function getHelpfulVotes(): number[] {
        try {
          const raw = localStorage.getItem(HELPFUL_KEY);
          return raw ? (JSON.parse(raw) as number[]) : [];
        } catch {
          return [];
        }
      }

      function initHelpfulButtons() {
        const voted = getHelpfulVotes();
        document.querySelectorAll<HTMLElement>('[data-helpful-button]').forEach((el) => {
          const id = Number(el.dataset.siteId);
          const countEl = el.querySelector('[data-helpful-count]');

          if (voted.includes(id)) {
            el.setAttribute('disabled', 'true');
            el.classList.add('text-amber-600', 'border-amber-300');
          }

          if (el.dataset.helpfulBound) return;
          el.dataset.helpfulBound = '1';
          el.addEventListener('click', async () => {
            if (voted.includes(id)) return;
            el.setAttribute('disabled', 'true');
            try {
              const res = await fetch('/api/mark-helpful', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ siteId: id }),
              });
              const data = (await res.json()) as { ok: boolean; count?: number };
              if (data.ok) {
                const current = getHelpfulVotes();
                current.push(id);
                localStorage.setItem(HELPFUL_KEY, JSON.stringify(current));
                if (countEl) countEl.textContent = data.count ? `(${data.count})` : '';
                el.classList.add('text-amber-600', 'border-amber-300');
              } else {
                el.removeAttribute('disabled');
              }
            } catch {
              el.removeAttribute('disabled');
            }
          });
        });
      }

      initHelpfulButtons();
      document.addEventListener('astro:page-load', initHelpfulButtons);

      function updateFadeTruncation() {
        document.querySelectorAll<HTMLElement>('.fade-truncate').forEach((el) => {
          el.classList.toggle('is-truncated', el.scrollWidth > el.clientWidth + 1);
        });
        document.querySelectorAll<HTMLElement>('.fade-clamp-2').forEach((el) => {
          el.classList.toggle('is-truncated', el.scrollHeight > el.clientHeight + 1);
        });
      }

      updateFadeTruncation();
      document.addEventListener('astro:page-load', updateFadeTruncation);

      let fadeResizeHandle: number | undefined;
      window.addEventListener('resize', () => {
        if (fadeResizeHandle) cancelAnimationFrame(fadeResizeHandle);
        fadeResizeHandle = requestAnimationFrame(updateFadeTruncation);
      });

      // Search suggestions and the bookmarks grid render cards via innerHTML
      // after this script runs, so watch for DOM insertions rather than
      // requiring every call site to re-trigger the check itself.
      let fadeMutationHandle: number | undefined;
      const fadeObserver = new MutationObserver(() => {
        if (fadeMutationHandle) cancelAnimationFrame(fadeMutationHandle);
        fadeMutationHandle = requestAnimationFrame(updateFadeTruncation);
      });
      fadeObserver.observe(document.body, { childList: true, subtree: true });
    </script>
  </body>
</html>
